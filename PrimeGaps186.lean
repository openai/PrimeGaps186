    isOpen_const.inter ((isOpen_lt
      (show Continuous (fun e : ℝ => 56 * («ω» + e) + 16 * (δ + e) + 4 * (σclass + e))
        from by fun_prop) continuous_const).inter
      (isOpen_lt (show Continuous (fun e : ℝ => 68 * («ω» + e) + 14 * (δ + e))
