theorem radiusTwelveSphere_geometry
    (t : ℝ) (z : ℂ)
    (hz : z ∈ sphere ((2 : ℂ) + t * I) 12) :
    -(10 : ℝ) ≤ z.re ∧ z.re ≤ 14 ∧
      |z.im| + 2 ≤ 7 * (|t| + 2) := by
  have hdist : ‖z - ((2 : ℂ) + t * I)‖ = 12 := by
    simpa [mem_sphere, Complex.dist_eq] using hz
  have hre : |z.re - 2| ≤ 12 := by
    simpa using (Complex.abs_re_le_norm (z - ((2 : ℂ) + t * I))).trans hdist.le
  have him : |z.im - t| ≤ 12 := by
    simpa using (Complex.abs_im_le_norm (z - ((2 : ℂ) + t * I))).trans hdist.le
  have hi := (abs_add_le (z.im - t) t).trans (add_le_add him (le_refl |t|))
  rw [sub_add_cancel] at hi
  obtain ⟨hrelo, hrehi⟩ := abs_le.mp hre
  refine ⟨?_, ?_, ?_⟩ <;> linarith only [hrelo, hrehi, hi, abs_nonneg t]

end PrimitiveLFunctionRadiusTwelve

theorem exists_nat_norm_LFunction_radiusTwelveSphere_le :
    ∃ E : ℕ, 36 ≤ E ∧
