          Function.support (fun u => (η u : ℂ)) = Set.Ioo Θ⁻¹ Θ ∧
          (∀ u : ℝ, 0 ≤ η u ∧ η u ≤ 1) ∧
          ∀ (r : ℕ) (u : ℝ),
            ‖iteratedDeriv r (fun u => (η u : ℂ)) u‖ ≤
              B r * (Real.log x) ^ (D * (r : ℝ)) := by
  obtain ⟨B, hB, hmain⟩ := sifted_short_geometric_profiles
  refine ⟨B, hB, ?_⟩
