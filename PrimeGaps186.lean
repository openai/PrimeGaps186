    have hpower : ell * ell ^ (D : ℝ) = ell ^ ((D : ℝ) + 1) := by
      rw [Real.rpow_add hellpos, Real.rpow_one]
      ring
    have hpowone : 1 ≤ ell ^ ((D : ℝ) + 1) :=
      Real.one_le_rpow hell (by positivity)
    have hcount' : ((R + 1 : ℕ) : ℝ) ≤ 6 * ell ^ ((D : ℝ) + 1) := by
