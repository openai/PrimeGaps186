  have hlarge : ∀ᶠ x : ℝ in Filter.atTop,
      Real.exp 1 ≤ x ∧ (Xp : ℝ) ≤ Real.exp (Real.sqrt (Real.log x)) ∧
        Real.exp (-c * Real.sqrt (Real.sqrt (Real.log x))) * (Real.log x) ^ B ≤
          (Real.log x) ^ (-A) := by
    filter_upwards [Filter.eventually_ge_atTop (Real.exp 1),
      hscale.eventually (Filter.eventually_ge_atTop (Xp : ℝ)),
      eventually_exp_neg_sqrt_sqrt_log_mul_rpow_le_rpow A B c hc]
      with x hx hscaleX hdecay
    exact ⟨hx, hscaleX, hdecay⟩
  obtain ⟨X0, hX0⟩ := Filter.eventually_atTop.mp hlarge
  let K : ℝ := 2 * C * T * H + 1
  refine ⟨K, max X0 (Real.exp 1), ?_, le_max_right _ _, ?_⟩
  · dsimp only [K]
    positivity
  intro x hx N hN ι I m w L U X hm hXL hXU hLU hw q _ hq r0 hr0 a ha
  obtain ⟨hxexp, hXp, hdecay⟩ := hX0 x ((le_max_left _ _).trans hx)
  have hx0 : 0 < x := (Real.exp_pos 1).trans_le hxexp
  have hlog : 0 < Real.log x := by
    have := (Real.le_log_iff_exp_le hx0).mpr hxexp
    linarith
  have hcomparison (i : ι) (hi : i ∈ I) :=
    largest_prime_scale_logarithmic_comparison
      x hxexp (X i) (hXL i hi) D c hD hc
  have hbound := hprime I m w L U X
    (fun i hi => Nat.cast_le.mp (hXp.trans (hXL i hi))) hLU q
    (fun i hi => hq.trans (hcomparison i hi).1) r0 hr0 a ha
