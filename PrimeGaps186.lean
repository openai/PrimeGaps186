    (hderivative i₁ hder₁) (hderivative i₂ hder₂) (hderivative i₃ hder₃)
    (a : ℤ) haunit
  have hf : finiteConvolution α
      (finiteConvolution (positiveCompactProfileSequence (ψ i₁) C (Ni i₁) 0)
        (finiteConvolution (positiveCompactProfileSequence (ψ i₂) C (Ni i₂) 0)
