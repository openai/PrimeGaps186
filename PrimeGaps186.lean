            ‖(if Nat.Coprime n q then f n else 0) / (q.totient : ℂ)‖ :=
          norm_sub_le _ _
        _ = ‖if n % q = a % q then f n else 0‖ +
            ‖if Nat.Coprime n q then f n else 0‖ / (q.totient : ℝ) := by
          rw [norm_div, Complex.norm_natCast]
        _ ≤ ‖f n‖ + ‖f n‖ := by
          apply add_le_add (hmask _ _)
          exact (div_le_div_of_nonneg_right (hmask _ _) (Nat.cast_nonneg _)).trans
            (div_le_self (norm_nonneg _) hφ)
        _ = 2 * ‖f n‖ := by ring
    _ = _ := (Finset.mul_sum _ _ _).symm

