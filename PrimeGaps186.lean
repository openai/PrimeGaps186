        (show 0 ∈ Finset.range 129 by simp)
      simpa only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one] using ht
    have he : 0 ≤ Real.exp (v : ℝ) - (E : ℝ) ∧
