    ‖S‖ = ‖∑ ℓ ∈ Finset.Icc (Int.ceil (-T * H)) (Int.floor (T * H)),
        if IsUnit (ℓ : ZMod q) then ψ ((ℓ : ℝ) / H) * f (ℓ : ZMod q)
        else 0‖ := congrArg norm hS
