              (v - u) * exceptionalMassCoefficient j| ≤ epsilon := by
  classical
  intro epsilon hepsilon
  have he4 : 0 < epsilon / 4 := by positivity
  let P (x : ℝ) : Finset ℕ :=
    (Finset.Icc (Nat.ceil (x ^ ((9519 : ℝ) / 50000)))
      (Nat.floor (x ^ ((6 : ℝ) / 25)))).filter Nat.Prime
  let w (x : ℝ) (p : Fin 4 → ℕ) : ℝ :=
    ((∏ i, (p i : ℝ)) * (1 - ∑ i, Real.logb x (p i : ℝ)))⁻¹
  let R (j : Fin 2) (x : ℝ) (p : Fin 4 → ℕ) : Prop :=
    let t : Fin 4 → ℝ := fun i => Real.logb x (p i : ℝ)
