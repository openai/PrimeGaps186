open Classical in
theorem vonMangoldt_closedSubinterval_divisor_weight_log_saving_of_dyadic
    (j : ℕ) (θ₀ θ₁ δ₀ δ₁ : ℝ)
    (hθ₀ : 0 < θ₀) (hθ : θ₀ < θ₁)
    (hδ₀ : 0 < δ₀) (hδ : δ₀ < δ₁) (hθsmall : θ₀ < 2 / 3)
