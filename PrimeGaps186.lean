        sourceT4ExponentMask (fun i => Real.logb x (q i : ℝ)) = true ∧
        sourceU1ExponentMask (fun i => Real.logb x (q i : ℝ)) = false)) ∧
    (((∏ i, p i) ∈ Finset.Icc ⌈x⌉₊ ⌊2 * x⌋₊ ∧
