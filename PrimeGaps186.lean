  classical
  dsimp only
  simp only [theta2_three_prime_interval_eq_sorted_prime_counts x u v hx hu huv,
    ← Finset.sum_sub_distrib]
  have hx0 : 0 < x := zero_lt_one.trans hx
  have h (p : ℕ) (hp : p.Prime) :=
    sorted_prime_count_bulk_strip (x / (p : ℝ))
      (x ^ ((9519 : ℝ) / 50000)) u v (div_pos hx0 (Nat.cast_pos.mpr hp.pos)) hu huv hv
