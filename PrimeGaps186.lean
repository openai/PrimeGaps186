        (sourceSecondaryDTerm m r₁ q₀ u₁ v₁ v₂ q₂ w₀ w₁
          A B ℓ E ψN ψD N Δ₁ d₀ j y y' T)
        (∑ d ∈ D, sourceSecondaryDTerm m r₁ q₀ u₁ v₁ v₂ q₂ w₀ w₁
          A B ℓ E ψN ψD N Δ₁ d₀ j y y' T d)) ∧
