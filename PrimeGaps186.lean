    have hp := Real.rpow_le_one_of_one_le_of_nonpos hlog1
      (show -D ≤ 0 by linarith)
    dsimp only [Θ]
    linarith
  obtain ⟨hc, hs, hr, hd⟩ := hmain Θ hΘ hΘ₂
  refine ⟨hΘ, hΘ₂, hc, hs, hr, ?_⟩
  intro r u
  calc
    _ ≤ B r / (Θ - 1) ^ r := hd r u
    _ = B r * (Real.log x) ^ (D * (r : ℝ)) := by
      rw [show Θ - 1 = (Real.log x) ^ (-D) by dsimp only [Θ]; ring]
      rw [← Real.rpow_natCast, ← Real.rpow_mul hlog.le,
        show -D * (r : ℝ) = -(D * (r : ℝ)) by ring,
        Real.rpow_neg hlog.le, div_inv_eq_mul]

