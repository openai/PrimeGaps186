          (by exact_mod_cast Nat.divisor_le ha)
      exact (hH i b a).trans
        (mul_le_mul (mul_le_mul_of_nonneg_left
          (pow_le_pow_left₀ (Nat.cast_nonneg _) hτ 9) (by norm_num))
