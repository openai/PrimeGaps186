    one_le_mul_of_one_le_of_one_le (by exact_mod_cast hg) hM
  have hpower : x ^ ε ≤ x := by
    simpa only [Real.rpow_one] using
      Real.rpow_le_rpow_of_exponent_le hxone hε
  constructor
  · calc
      _ ≤ x ^ ε * R * Q ^ 2 := div_le_self (by positivity) hden
      _ ≤ x * x * x ^ 2 := mul_le_mul
        (mul_le_mul hpower hRupper hR hxnonneg)
        (pow_le_pow_left₀ hQ hQupper 2) (sq_nonneg Q) (mul_nonneg hxnonneg hxnonneg)
      _ = x ^ 4 := by ring
  · calc
      2 * Q ≤ 2 * x := mul_le_mul_of_nonneg_left hQupper (by norm_num)
      _ ≤ x * x := mul_le_mul_of_nonneg_right hx hxnonneg
      _ = x ^ 2 := (pow_two x).symm

