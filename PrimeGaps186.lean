        ((if v t % q = a % q then (1 : ℂ) else 0) -
          (if Nat.Coprime (v t) q then (1 : ℂ) else 0) / (q.totient : ℂ)) := by
  rw [fullDiscrepancy_eq_finsupp_sum]
  rw [← Finsupp.sum_finsetSum_index
    (fun n => by simp)
    (fun n z w => by split_ifs <;> ring)]
  apply Finset.sum_congr rfl
  intro t _ht
  rw [Finsupp.sum_single_index (by simp)]
  split_ifs <;> ring

