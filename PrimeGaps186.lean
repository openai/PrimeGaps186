    ∀ (a₀ : ℤ) (a : ∀ q : ℕ+, (ZMod (q : ℕ))ˣ),
      (∀ q ∈ Qset, (a q : ZMod (q : ℕ)) = (a₀ : ZMod (q : ℕ))) →
