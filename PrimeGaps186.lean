  clear hcenter P
  have hsample (i : ℕ) (hi : i ≤ R) : (i : ℝ) / N ∈ Set.Icc (0 : ℝ) H :=
    ⟨by positivity, (div_le_iff₀ hN).2 ((Nat.mono_cast hi).trans hR)⟩
  have hweighted (K : ℕ) (hK : K ≤ R + 1) :
      ‖∑ n ∈ Finset.range K, ψ ((n : ℝ) / N) * z n‖ ≤ B * ((1 + H) * V) := by
    clear * - K hK R N H V ψ z B hB hH hN hV hψ hψbound hsample hprefix
