      intro m _
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro n₁ _
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro n₂ _
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
