    (ψM wN ψD : ℝ → ℝ)
    (r₁ q₀ u q₂ a b₁ b₂ : ℕ) (ℓ : ℤ)
    (_ : 0 < r₁) (_ : 0 < q₀) (_ : 0 < u) (_ : 0 < q₂)
    (hV : 0 < V) (hc : 0 < c) (hcT : c ≤ T)
    (hM : 0 < M) (hL : 0 ≤ L)
    (hsM : Function.support ψM ⊆ Set.Icc c T)
    (hbM : ∀ t : ℝ, |ψM t| ≤ L)
    (hsN : ∀ n : ℤ, n ∉ s → wN (n : ℝ) = 0)
