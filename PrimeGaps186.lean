    have hineq : 4 * ((m - 1) * L) ≤ 3 * m * L + E * L :=
      hlower.trans hupperE
    have hcoef : 0 < m - 4 - E := by
      linarith only [hMcoef]
    have hmargin : 0 < (m - 4 - E) * L := mul_pos hcoef hLpos
    nlinarith only [hineq, hmargin]

