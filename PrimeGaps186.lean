      (∑ t ∈ block g ℓ i, K g ℓ t) = F g ℓ (block g ℓ i) (J g) := by
    have : NeZero g := NeZero.of_pos (hfactor.1 g hg).1
    have hblock : ∀ t ∈ block g ℓ i,
