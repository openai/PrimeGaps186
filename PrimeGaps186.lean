            · exact hη r₂.val r₂.property s.val h.1
            · exact hα m₁ hm₁
            · exact hα m₂ hm₂
            · exact hU r₁ r₂ s m₁ m₂ h.1 h.2.1 h.2.2.1
          _ = (s.val : ℝ) * K := by ring
      · rw [ite_eq_right h]
        positivity
    _ = (I.card : ℝ) * (K * (τ : ℝ)) *
        ∑ r ∈ R, ∑ s ∈ S r, (s : ℝ) := by
      calc
        _ = ∑ r : R, ∑ _m ∈ I, ∑ s ∈ S r.val,
            (s : ℝ) * K * (τ : ℝ) := by
          apply Finset.sum_congr rfl
          intro r _
          apply Finset.sum_congr rfl
