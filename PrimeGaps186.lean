theorem sourceT4U1_eventually_compact_tuple_geometry :
    ∃ X : ℝ, 3 ≤ X ∧ ∀ x : ℝ, X ≤ x → ∀ p : Fin 4 → ℕ,
      (∀ i, (p i).Prime) →
      (∏ i, p i) ∈ Finset.Icc ⌈x⌉₊ ⌊2 * x⌋₊ →
      let α : Fin 4 → ℝ := fun i => Real.logb x (p i : ℝ)
