  rw [Measure.dirac_apply_of_mem hpa, hA] at hle
  exact not_le_of_gt zero_lt_one hle

theorem primeLogConfiguration_total_mass
    (d : ℕ) (R : ℝ) (hR : 1 < R) (r : Fin d → ℕ)
