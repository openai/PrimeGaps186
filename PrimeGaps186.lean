          if (n : ZMod q₀) ∈ E (d : ZMod q₀) then 1 else 0 := by
  intro m E
  let : NeZero r₁ := ⟨hpos.1.ne'⟩
  let : NeZero q₀ := ⟨hpos.2.1.ne'⟩
  let : NeZero u₁ := ⟨hpos.2.2.1.ne'⟩
  let : NeZero v₁ := ⟨hpos.2.2.2.1.ne'⟩
