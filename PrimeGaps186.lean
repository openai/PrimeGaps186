                Finsupp.single n ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) q a‖) ≤
            K * x / (Real.log x) ^ A) :
    ∀ A : ℝ, 0 < A → ∃ K X : ℝ,
      0 < K ∧ Real.exp 1 ≤ X ∧ ∀ x : ℝ, X ≤ x →
      ∀ u v : ℝ, x ≤ u → u ≤ v → v ≤ 2 * x →
      ∀ I : Finset ℕ, (∀ p ∈ I, Nat.Prime p) →
      ∀ a : ℕ, Nat.Coprime a (∏ p ∈ I, p) →
        (∑ q ∈ (Finset.Icc 1 ⌊x ^ θ⌋₊).filter (fun q =>
          q ∣ ∏ p ∈ I, p ∧
          Nonempty (DenseDivisibilityWitness
            ⟨max 1 (x ^ δ), le_max_left (1 : ℝ) (x ^ δ)⟩ j q)),
