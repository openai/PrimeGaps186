        ‖total‖ ≤ COut * x ^ (2 * ε) * (Int.gcd Jnum (m : ℤ) : ℝ) *
          (∏ p : m.primeFactors, max 1 (K p)) * (1 / (q₀ : ℝ)) *
          (N / Real.sqrt (m : ℝ) + Real.sqrt (m : ℝ)) *
          (D / Real.sqrt (m : ℝ) + Real.sqrt (m : ℝ)) := by
  let b : ℝ := 1 + ε
