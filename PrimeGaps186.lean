theorem sourceSmoothFactor_fiber_uniform_power_saving
    («ω» δ ε C cN TN L : ℝ)
    (hω : 0 < «ω») (hδ : 0 < δ) (hε : 0 < ε) (hεsmall : ε ≤ 1 / 1000)
    (hC : 1 ≤ C) (hcN : 0 < cN) (_hNT : cN ≤ TN) (hL : 0 ≤ L) :
    ∃ K X : ℝ, 0 < K ∧ 1 ≤ X ∧
      ∀ x : ℝ, X ≤ x →
      ∀ M N R Q H γ : ℝ,
        0 < M → 0 < N → 0 < R → 0 < Q →
        x / C ≤ M * N → N = x ^ γ →
        N ≤ C * x ^ (δ + 6 * ε) * R →
        R ≤ C * x ^ (-2 * ε) * N →
        x ^ (1 / 2 - ε) ≤ C * R * Q →
        R * Q ≤ C * x ^ (1 / 2 + 2 * «ω» + ε) →
        1 / 4 + 7 * «ω» + 2 * δ + 100 * ε ≤ γ →
        γ ≤ 1 / 2 + ε →
      ∀ r q₀ a b₁ b₂ : ℕ, 0 < r → 0 < q₀ →
        R ≤ (r : ℝ) → (r : ℝ) ≤ 2 * R →
        H = x ^ ε * R * Q ^ 2 / ((q₀ : ℝ) * M) → 1 ≤ H →
      ∀ (Y : Set.Ici (1 : ℝ)), (Y : ℝ) ≤ x ^ δ →
      ∀ (F : Finset (ℕ × ℕ)) (J : Finset ℤ),
