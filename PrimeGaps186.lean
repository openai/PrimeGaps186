      rw [hdyRatio y z hy hs] at hband
      have hpowR : 0 < ((2 ^ Nat.log 2 z.natAbs : ℕ) : ℝ) := by positivity
      have hloR : ((2 ^ Nat.log 2 z.natAbs : ℕ) : ℝ) ≤ (y.natAbs : ℝ) := by
