  have hU (r₁ r₂ : R) (s : S r₁.val) (m₁ m₂ : ℕ)
      (hs₂ : s.val ∈ S r₂.val)
      (hm₁ : IsUnit (m₁ : ZMod (r₁.val * s.val)))
      (hm₂ : IsUnit (m₂ : ZMod (r₂.val * s.val))) :
      ‖U r₁ r₂ s m₁ m₂‖ ≤ Lw * (L.card : ℝ) * (9 : ℝ) ^ Ω := by
    have hc : Nat.Coprime s.val (r₁.val * r₂.val) :=
      (hcop r₁.val r₁.property s.val s.property).symm.mul_right
        (hcop r₂.val r₂.property s.val hs₂).symm
    calc
      _ ≤ Lw * (L.card : ℝ) *
          (3 : ℝ) ^ ((r₁.val * s.val).primeFactors.card +
            (r₂.val * s.val).primeFactors.card) := by
        simpa only [U, L, Int.cast_natCast] using
          typeIII_mixed_reciprocal_compactProfile_elementary_norm_le_of_deligne
            hDeligne s.val r₁.val r₂.val
            (hS r₁.val r₁.property s.val s.property)
            (hR r₁.val r₁.property) (hR r₂.val r₂.property) hc
            A (m₁ : ℤ) (m₂ : ℤ)
            (hA r₁.val r₁.property r₂.val r₂.property s.val s.property hs₂)
            (by simpa only [Int.cast_natCast] using hm₁)
            (by simpa only [Int.cast_natCast] using hm₂)
