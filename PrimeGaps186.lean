open Classical in
theorem positiveCompactProfileSequence_apply
    (c T N : ℝ) (hc : 0 < c) (hN : 0 < N)
    (ψ : ℝ → ℂ) (hsupport : Function.support ψ ⊆ Set.Icc c T) (n : ℕ) :
    positiveCompactProfileSequence ψ T N 0 n = ψ ((n : ℝ) / N) := by
  have hmem (hn : ψ ((n : ℝ) / N) ≠ 0) :
      n ∈ Finset.Icc 1 ⌊T * N⌋₊ := by
    have h := hsupport hn
    have hnpos : 0 < (n : ℝ) :=
      (mul_pos hc hN).trans_le ((le_div_iff₀ hN).mp h.1)
    exact Finset.mem_Icc.mpr ⟨Nat.cast_pos.mp hnpos,
      Nat.le_floor ((div_le_iff₀ hN).mp h.2)⟩
  simp only [positiveCompactProfileSequence, zero_add, sub_zero,
    Finsupp.finsetSum_apply, Finsupp.single_apply, Finset.sum_ite_eq']
  by_cases hn : n ∈ Finset.Icc 1 ⌊T * N⌋₊
  · simp [hn]
  · have hz : ψ ((n : ℝ) / N) = 0 := by
      by_contra h
      exact hn (hmem h)
    simp [hn, hz]

