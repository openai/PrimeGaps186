      have hm' : Real.sqrt x < scale ν 0 := lt_of_not_ge hm
      have hh := mul_lt_mul_of_pos_left hfar hMpos
      have hh' := mul_lt_mul_of_pos_right hm' (by positivity : 0 < 8 * Real.sqrt x)
      nlinarith only [hMNone.2, hsqrt, hh, hh']
