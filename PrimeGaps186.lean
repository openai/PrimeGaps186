          normalizedKloosterman3Mod (r₁ * s)
            (((A : ZMod (r₁ * s)) * (m₁ : ZMod (r₁ * s))⁻¹) *
              (ℓ : ZMod (r₁ * s))) *
          star (normalizedKloosterman3Mod (r₂ * s)
            (((A : ZMod (r₂ * s)) * (m₂ : ZMod (r₂ * s))⁻¹) *
