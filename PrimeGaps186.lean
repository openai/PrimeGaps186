      have hmF := minorantHBClosedMangoldt_norm_le
        (A i) (B i) (t i) (hA i) (hAB i) (ht i) m
      by_cases hm : m = 0
      · simpa only [hm, Nat.cast_zero, Real.log_zero, mul_zero] using hmF
      · have hτ : 1 ≤ (m.divisors.card : ℝ) := by
          exact_mod_cast Finset.card_pos.mpr ⟨1, Nat.one_mem_divisors.mpr hm⟩
        have hscale : 1 ≤ 32 * (m.divisors.card : ℝ) ^ 9 :=
