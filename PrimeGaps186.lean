        (∑ n ∈ Finset.Icc 1 ⌊Θ * scale ν 0⌋₊,
          Finsupp.single n ((η ((n : ℝ) / scale ν 0) * S0 n : ℝ) : ℂ))
        (∑ n ∈ Finset.Icc 1 ⌊Θ * scale ν 1⌋₊,
