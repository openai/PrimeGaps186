        18 * ((x : ℝ) / Real.rpow (Real.log (x : ℝ)) A) := by
    have h := (mul_le_mul hthirdRoot hlogPowerLe hlogPowerNonneg
      (Real.rpow_nonneg hxpos.le _)).trans hthirdScale
    nlinarith only [h]
  have hQdivRone :
      (1 : ℝ) ≤ (Q : ℝ) /
          (siegelWalfiszConductorCutoff (A + 5) x : ℝ) :=
    (one_le_div hRpos).2 hRQReal
  have hargOne :
