          _ ≤ x ^ (3 * ε / 2) * Qcenter ^ 3 :=
            mul_le_mul_of_nonneg_left hHle (by positivity)
          _ ≤ x ^ (3 * ε / 2) * (C * x ^ qExp) ^ 3 :=
