      simp [Fin.sum_univ_succ] at hzd
      linarith
    have hR : 0 ≤ 1 - z 0 - z 2 := by linarith
    have hT : 0 ≤ 1 + z 0 + z 1 + z 3 := by linarith
    have hb : 0 ≤ z 1 + 2 := by linarith [hzl 1]
    have hab : 0 ≤ z 0 - z 1 := by linarith
    have hcb : 0 ≤ z 2 - z 1 := by linarith
    by_cases hU : 0 ≤ z 2 - 2 * z 1 - 2
    · apply Set.mem_iUnion.mpr
      refine ⟨0, ?_⟩
      refine mem_convexHull_of_exists_fintype
        (![(1 - z 0 - z 2) / 5, 3 * (z 1 + 2) / 5,
          2 * (z 2 - 2 * z 1 - 2) / 5,
