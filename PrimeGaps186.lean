    Fin.cons_succ (α := fun _ : Fin 4 => ℕ) p r (2 : Fin 3)
  simp only [Fin.cons_zero, Fin.cons_one, htwo, hthree] at h
  simpa only [← centralPair_three_weighted] using h

open Classical in
theorem centralPair_five_weighted (n : ℕ) (w : ℕ → ℕ → ℕ → ℕ → ℕ → ℝ) :
    (∑ d ∈ n.divisorsAntidiagonal, if d.1.Prime then
