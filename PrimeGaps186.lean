    rw [hKhi]
    exact firstOuterLowTruncatedConvolution_getD_eq_coeff_mul _ _ _ _ hAhi hMT j hj
  have hsizeT : Tarr.size = 98304 := Array.size_ofFn
  have hsizeMT : MTarr.size = 98304 := by
    by_cases he : e.val = 0
    · simpa only [MTarr, ite_eq_left he] using hsizeT
    · simp only [MTarr, ite_eq_right he, firstOuterLowTruncatedConvolution, Array.size_ofFn]
  have hsizeLo : K.1.size = 98304 := by
    rw [hKlo]
    exact Array.size_ofFn
  have hsizeHi : K.2.size = 98304 := by
    rw [hKhi]
