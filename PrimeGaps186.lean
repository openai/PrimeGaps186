        ∑ q ∈ Q, (‖P q v‖ + ‖P q u‖ + ‖E q u‖) := by
      apply Finset.sum_le_sum
      intro q _
      have heq := hclosed_prefix (Wq q) u v hu1 huv
      change (∑ n ∈ Finset.Icc ⌈u⌉₊ ⌊v⌋₊, Wq q n) = P q v - P q u + E q u at heq
      rw [heq]
      exact (norm_add_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
