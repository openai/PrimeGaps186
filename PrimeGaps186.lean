theorem prod_prime_rankin_factor_le_exp_reciprocal_sum
    (j : ℕ) (Y : ℝ) (hY : 0 < Y) (hlogY : 2 ≤ Real.log Y) :
    (∏ p ∈ Nat.primesLE ⌊Y⌋₊,
      ((1 - (p : ℝ) ^ (-(1 - 1 / Real.log Y)))⁻¹) ^ j) ≤
