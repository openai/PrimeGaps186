            (le_mul_of_one_le_right (by norm_num) (one_le_pow₀ hτ))
        exact hmF.trans (le_mul_of_one_le_left (Real.log_natCast_nonneg m) hscale)
    · simpa only [H, ite_true] using minorantHBUnmaskedFive_norm_le
        (A i) (B i) U Θ (t i) (hA i) (hAB i) hU (hBU i)
        hΘ hΘtwo (ht i) (htten i) m
  have hzero (i : Fin 3) (b : Bool) : H i b 0 = 0 := by
    apply norm_eq_zero.mp
    apply le_antisymm ?_ (norm_nonneg _)
    simpa only [Nat.cast_zero, Real.log_zero, mul_zero] using hH i b 0
