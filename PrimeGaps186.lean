  have hlogHhi : Real.log H ≤ 2 * Real.log x := by
    nlinarith only [hlogH, hlogRhi, hlogQ, hlogq, hlogM,
      mul_le_mul_of_nonneg_right hεsmall hlogx, hlogx]
  have hpositive (t : ℕ × ℕ) (ht : t ∈ F) : 0 < t.1 ∧ 0 < t.2 :=
    ⟨Nat.pos_of_ne_zero (hF t ht).1.of_mul_left.of_mul_right.ne_zero,
      Nat.pos_of_ne_zero (hF t ht).1.of_mul_right.ne_zero⟩
  have hcoordinate (t : ℕ × ℕ) (ht : t ∈ F) :
      (t.1 : ℝ) ≤ 2 * Q / (q₀ : ℝ) ∧ (t.2 : ℝ) ≤ 2 * Q / (q₀ : ℝ) := by
    constructor
    · apply (le_div_iff₀ hq₀R).mpr
      simpa only [Nat.cast_mul, mul_comm] using (hF t ht).2.2.1
    · apply (le_div_iff₀ hq₀R).mpr
      simpa only [Nat.cast_mul, mul_comm] using (hF t ht).2.2.2.2
  have hq₀Q : (q₀ : ℝ) ≤ 2 * Q := by
    have hq₁ : (1 : ℝ) ≤ (q.1 : ℝ) := by exact_mod_cast (hpositive q hqF).1
    have hh := (hF q hqF).2.2.1
