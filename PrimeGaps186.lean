    obtain ⟨hu, _, hq₁, hq₂, hsf, _, _, hq₁lo, hq₁hi, hq₂lo, hq₂hi⟩ := h𝒜 t htA
    refine ⟨hq₁, hq₂, ?_, hq₁lo, hq₁hi, hq₂lo, hq₂hi⟩
