    nlinarith only [hchiLower, hprincipalLower]
  have hstrict :
      3 * m * L + 3 * C <
        (7 * m - 8 - 4 * K - 2 * J) * L := by
    nlinarith only [hmarginLog, hmTwo, hLpos]
  exact (not_lt_of_ge hlower) (hupper.trans hstrict)

