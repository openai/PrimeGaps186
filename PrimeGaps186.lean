theorem physicalSource_finite_inner_event_cover (ν : Fin 2) :
    ∀ (Y : Fin 39 → FiniteMeasure ℝ) (n : Fin 39 → ℕ)
      (x : (i : Fin 39) → Fin (n i) → ℝ),
      (∀ i, (Y i).restrict (Set.Ioc (0 : ℝ) (trialMesh : ℝ)) = Y i) →
