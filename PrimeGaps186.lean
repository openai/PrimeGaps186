      (∑ j ∈ J, 1 / Real.sqrt (((2 : ℕ) ^ j : ℕ) : ℝ)) ≤
        8 / Real.sqrt Rlo := by
    have h : (∑ j ∈ J, 1 / Real.sqrt ((2 : ℝ) ^ j)) ≤ 4 / s ^ m := by
