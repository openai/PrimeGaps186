theorem minorant_halfspaces1_eq_iUnion :
    {z : Fin 4 → ℝ | (∀ j, -2 ≤ z j) ∧ -2 ≤ -(∑ j, z j) ∧
      z 1 ≤ z 0 ∧ z 2 ≤ z 1 ∧ z 3 ≤ z 2 ∧
      z 3 ≤ -(∑ j, z j) ∧ z 0 + z 1 ≤ 1 ∧
      -1 ≤ z 1 + z 2 + z 3} =
