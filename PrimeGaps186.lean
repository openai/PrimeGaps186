    ‖sourceDispersionFrequencyBlock (Ediag p.2) ψM wN M
      (p.1 * r₁) q₀ u p.2.1 p.2.2 q₂ a b₁ b₂ ℓ‖
  let Boff : ℕ × ℕ × ℕ → ℝ := fun p =>
    ‖sourceDispersionFrequencyBlock (Eoff p.2) ψM wN M
      (p.1 * r₁) q₀ u p.2.1 p.2.2 q₂ a b₁ b₂ ℓ‖
