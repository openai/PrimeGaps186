    refine ⟨hp, by exact_mod_cast Nat.le_of_dvd hp hdr, ?_⟩
    calc
      (P t s : ℝ) ≤ (r : ℝ) * (q₀ : ℝ) * (t.1 : ℝ) * (t.2 : ℝ) * (s.1 : ℝ) * (s.2 : ℝ) := by
