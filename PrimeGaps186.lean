    (hprim : ∀ p ∈ S, Nat.Coprime (a * b₁ * b₂) (p.1 * p.2))
    (hu : ∀ p₁ ∈ S, ∀ p₂ ∈ S, p₁.2 = p₂.2 →
      let g := Nat.gcd p₁.1 p₂.1
