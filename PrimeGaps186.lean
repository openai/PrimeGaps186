  let bsum : (n : ℕ) → (Fin 39 → Fin (m n + 1) → ℝ) → Fin (m n + 1) → ℝ :=
    fun n v j => ∑ i, v i j
  let tail : (n : ℕ) → (Fin 39 → Fin (m n + 1) → ℝ) → Fin (m n + 1) → ℝ :=
