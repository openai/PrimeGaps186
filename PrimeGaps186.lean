      (∀ (p : ℕ) [Fact p.Prime] (A B : ZMod p),
        A ≠ 0 → B ≠ 0 →
          ‖∑ t : ZMod p, if t ≠ 0 ∧ t ≠ -1 then
            unnormalizedKloosterman2 p (A / t) *
              unnormalizedKloosterman2 p (B / (t + 1)) else 0‖ ≤
            8 * (p : ℝ) * Real.sqrt (p : ℝ)))
    (R I : Finset ℕ) (S : ℕ → Finset ℕ)
    (hR : ∀ r ∈ R, Squarefree r)
    (hI : ∀ m ∈ I, 0 < m)
    (hS : ∀ r ∈ R, ∀ s ∈ S r, Squarefree s)
    (hcop : ∀ r ∈ R, ∀ s ∈ S r, Nat.Coprime r s)
