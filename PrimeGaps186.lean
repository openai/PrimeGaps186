          _ ≤ ((b₀ - τ) + (b₀ - τ)) / 2 :=
            div_le_div_of_nonneg_right (add_le_add he.le le_rfl) (by norm_num)
          _ = b₀ - τ := by ring
          _ ≤ b₀ := sub_le_self b₀ hτ.le : θ + ε ≤ b₀)).trans (hlarge'.trans hratio)
