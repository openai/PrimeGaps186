open Classical in
theorem theta6_a0_first_prime_window_indicator
    (p m u v : ℕ) (hp : Nat.Prime p) (hm : 0 < m)
    (z H S M0 L U : ℝ) (hH : 0 < H) (hS : 0 < S) :
