theorem minorantHB_two_original_cofactor_norm_le
    (A B t : Fin 3 → ℝ) (U Θ : ℝ)
    (hA : ∀ c, 1 ≤ A c) (hAB : ∀ c, A c ≤ B c)
    (hU : 0 ≤ U) (hBU : ∀ c, B c ≤ U ^ 5)
    (hΘ : 1 < Θ) (hΘtwo : Θ ≤ 2)
    (ht : ∀ c, 0 ≤ t c) (htten : ∀ c, t c ≤ 10)
    (c d : Fin 3) (e f : Bool) :
    let H : Fin 3 → Bool → ℕ →₀ ℂ := fun i b =>
      if b then minorantHBUnmaskedFive (A i) (B i) U Θ (t i)
      else minorantHBClosedMangoldt (A i) (B i) (t i)
    (∀ m : ℕ,
      ‖((MonoidAlgebra.ofCoeff (H c e) : MonoidAlgebra ℂ ℕ) *
        MonoidAlgebra.ofCoeff (H d f)).coeff m‖ ≤
          1024 * (m.divisors.card : ℝ) ^ 19 * (Real.log (m : ℝ)) ^ 2) ∧
      ((MonoidAlgebra.ofCoeff (H c e) : MonoidAlgebra ℂ ℕ) *
        MonoidAlgebra.ofCoeff (H d f)).coeff 0 = 0 := by
  classical
  intro H
  have hH (i : Fin 3) (b : Bool) (m : ℕ) :
      ‖H i b m‖ ≤ 32 * (m.divisors.card : ℝ) ^ 9 * Real.log (m : ℝ) := by
    cases b
