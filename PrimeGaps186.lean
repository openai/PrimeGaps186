        exact measureReal_mono (Set.subset_univ _)
      obtain ⟨hfinite, hcount⟩ := (physicalSourceCountMeasure_regular d).2 (e.1 : ℝ) he X
      have hcountM : (physicalSourceCountMeasure X).real
