      (v : ℝ) ≤ 2 * Q * (Y : ℝ) / X g := by
  have hex (g q : ℕ) : ∃ u : ℕ,
      0 < g → g ∣ q → Q ≤ (q : ℝ) → (q : ℝ) ≤ 2 * Q →
      Nonempty (DenseDivisibilityWitness Y 1 q) →
      1 ≤ X g → X g ≤ Q →
      let v := (q / g) / u
      0 < u ∧ 0 < v ∧ u ∣ q / g ∧ g * u * v = q ∧
      X g / ((g : ℝ) * (Y : ℝ)) ≤ (u : ℝ) ∧ (u : ℝ) ≤ X g ∧
