              (ℓ : ZMod (r₁.val * s.val))) *
          star (normalizedKloosterman3Mod (r₂.val * s.val)
            (((A : ZMod (r₂.val * s.val)) * (m₂ : ZMod (r₂.val * s.val))⁻¹) *
              (ℓ : ZMod (r₂.val * s.val)))) else 0
    (∑ r₁ : {r : ℕ // r ∈ R}, ∑ m₁ ∈ I,
      ∑ s : {s : ℕ // s ∈ S r₁.val},
      ∑ r₂ : {r : ℕ // r ∈ R}, ∑ m₂ ∈ I,
        if s.val ∈ S r₂.val ∧
            IsUnit (m₁ : ZMod (r₁.val * s.val)) ∧
            IsUnit (m₂ : ZMod (r₂.val * s.val)) ∧
            (r₁.val : ℤ) ^ 3 * (m₁ : ℤ) - (r₂.val : ℤ) ^ 3 * (m₂ : ℤ) = 0
        then (s.val : ℝ) * ‖η r₁.val s.val‖ * ‖η r₂.val s.val‖ *
          ‖α m₁‖ * ‖α m₂‖ * ‖U r₁ r₂ s m₁ m₂‖ else 0) ≤
      Wη ^ 2 * Wα ^ 2 * Lw * (L.card : ℝ) * (9 : ℝ) ^ Ω *
        (τ : ℝ) * (I.card : ℝ) *
          ∑ r ∈ R, ((S r).card : ℝ) * (((S r).sup id : ℕ) : ℝ) := by
  intro L τ Ω
  let K := Wη ^ 2 * Wα ^ 2 * Lw * (L.card : ℝ) * (9 : ℝ) ^ Ω
  have hK : 0 ≤ K := by positivity
  have hfiber (r₁ : R) (m₁ : ℕ) (hm₁ : m₁ ∈ I)
      (f : R → ℕ → ℝ) (c : ℝ) (hc : 0 ≤ c)
      (hf : ∀ r₂ : R, ∀ m₂ ∈ I,
        f r₂ m₂ ≤ if (r₁.val : ℤ) ^ 3 * (m₁ : ℤ) -
          (r₂.val : ℤ) ^ 3 * (m₂ : ℤ) = 0 then c else 0) :
      (∑ r₂ : R, ∑ m₂ ∈ I, f r₂ m₂) ≤ c * (τ : ℝ) := by
    let D := (R ×ˢ I).filter (fun rm : ℕ × ℕ =>
      (r₁.val : ℤ) ^ 3 * (m₁ : ℤ) - (rm.1 : ℤ) ^ 3 * (rm.2 : ℤ) = 0)
    have hcard : D.card ≤ τ :=
      Finset.le_sup_of_le (s := R ×ˢ I) (b := (r₁.val, m₁))
        (f := fun rm : ℕ × ℕ => (rm.1 ^ 3 * rm.2).divisors.card)
        (Finset.mem_product.mpr ⟨r₁.property, hm₁⟩)
        (typeIII_exactDiagonal_positive_fiber_card_le_divisors
          r₁.val m₁ (Nat.pos_of_ne_zero (hR r₁.val r₁.property).ne_zero)
          (hI m₁ hm₁) R I)
    calc
      _ ≤ ∑ r₂ : R, ∑ m₂ ∈ I,
