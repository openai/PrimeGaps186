open Classical in
theorem opening_padded_count (x H : ℝ) (hx : Real.exp 1 ≤ x) (hH : H ≤ x ^ (4 : ℝ)) :
    let k : ℕ := if H < 1 then 0 else Nat.log 2 ⌊H⌋₊ + 1
