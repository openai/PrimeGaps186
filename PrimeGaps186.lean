          ∑ ℓ ∈ Finset.Icc lo hi,
            if IsUnit (ℓ : ZMod n) then ψ ((ℓ : ℝ) / H) * f (ℓ : ZMod n)
            else 0 := by
      change (∑ x : ZMod n, integerIntervalResidueWeight n lo N w x * F x) = _
      rw [(integerIntervalResidueWeight_spec n lo N w).1 F,
        Int.Icc_eq_finset_map, Finset.sum_map]
      apply Finset.sum_congr rfl
      intro j _
      simp only [Function.Embedding.trans_apply, Nat.castEmbedding_apply,
        addLeftEmbedding_apply, w, F, Int.cast_add, Int.cast_natCast]
      split_ifs <;> simp only [mul_zero]
    have hbound' :
        ‖∑ x : ZMod n, W x * F x‖ ≤
          (6 * (2 * T + 3)) * Lw * (1 + H / (n : ℝ)) * K :=
      (hpairing n F W K hF).trans (mul_le_mul_of_nonneg_right hl1 hK)
    rw [hperiod] at hbound'
    exact hbound'
  let q := s * Nat.lcm r₁ r₂
  let d := Nat.gcd r₁ r₂
  let u₁ := r₁ / d
  let u₂ := r₂ / d
  let : NeZero (r₁ * s) := ⟨mul_ne_zero h₁.ne_zero hs.ne_zero⟩
  let : NeZero (r₂ * s) := ⟨mul_ne_zero h₂.ne_zero hs.ne_zero⟩
  let : NeZero q :=
