    by_cases hji : j = i
    · subst j
      simp only [Y, Function.update_self]
      constructor
      · linarith [(hLU i).1]
      · constructor <;> nlinarith [(hLU i).2, hL i]
    · simp only [Y, Function.update_of_ne hji]
      exact ⟨by linarith [hL j], le_refl _, by nlinarith [(hLU j).2, hL j]⟩
