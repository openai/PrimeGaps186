    apply Finset.sum_eq_zero
    intro cc _hcc
    apply ite_eq_right
    intro h
    have hb1 : bb.1 = 1 := h.2.2.1
    have hb2 : bb.2 = m := by
      simpa only [hb1, one_mul] using (Nat.mem_divisorsAntidiagonal.mp hbb).1
