    apply Fintype.mem_piFinset.mpr
    intro i
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_Icc.mpr ⟨Nat.ceil_le.mpr ?_,
      (Nat.le_floor_iff (Real.rpow_nonneg hx0.le _)).mpr ((hupper i).trans hx.2.2.2)⟩,
