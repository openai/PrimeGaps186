        D j k * (L * (Real.log x) ^ E) * N ^ (j + 1) / (1 + N * |y|) ^ k := by
    exact hD j k (L * (Real.log x) ^ E) N hLN hN1 ψ hψ hsψ
      (fun r hr t => hbψ r (by omega) t) y hy
  have habscenter (h : ℤ) (hh : |(h : ℝ)| ≤ H) :
      |(h : ℝ) / Qcenter| ≤ 1 / 8 := by
    rw [abs_div, abs_of_pos hQ]
