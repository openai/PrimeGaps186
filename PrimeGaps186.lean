    let L (i : Fin 4) : ℝ := max (x ^ ((9519 : ℝ) / 50000)) ((1 + h) ^ b i)
    let U (i : Fin 4) : ℝ := min (x ^ ((11 : ℝ) / 25))
      ((⌈(1 + h) ^ (b i + 1)⌉₊ - 1 : ℕ) : ℝ)
    (∀ i, p i ∈ P) →
