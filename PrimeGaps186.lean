theorem sourceDispersion_positive_support_eq_finite
    (E : Finset (ℤ × ℤ)) (J : Finset ℤ)
    (ψM ψN ψD : ℝ → ℝ) (M N Δ₁ d₀ cN TN cD TD : ℝ)
