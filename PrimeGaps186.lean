theorem geometric_small_monomial_test_crossing
    (h : ℝ) (hh : 0 < h) (d : MinorantSmallMonomialCut (arity + 1)) (hd : 0 ≤ d.threshold)
    (p q : Fin (arity + 1) → ℕ) (hp : ∀ i, 1 ≤ p i) (hq : ∀ i, 1 ≤ q i)
