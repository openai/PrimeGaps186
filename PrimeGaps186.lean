            else 0) -
          ((∑ n ∈ Finset.Icc ⌈x⌉₊ ⌊2 * x⌋₊,
            if (n + h i).Prime then (1 : ℝ) else 0) / ((W x).totient : ℝ)) *
            (∑ d ∈ D x, ∑ e ∈ E x,
              if ∀ a b : Fin 39, a ≠ b → Nat.Coprime (d a) (e b) then
