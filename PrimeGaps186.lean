    · exact ⟨S, Or.inl rfl, hS, hSne, hs⟩
    · refine ⟨Sᶜ, Or.inr rfl, hSc,
        (Finset.compl_ne_univ_iff_nonempty S).mpr hS, ?_⟩
      simpa only [compl_compl] using (le_of_not_ge hs)
  obtain ⟨i, hi⟩ := hRn
  let Y : Fin 4 → ℝ := Function.update L i (U i / 2)
