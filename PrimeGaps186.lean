  calc
    _ ≤ ∑ n ∈ S, ‖(if n % q = a % q then f n else 0) -
        (if Nat.Coprime n q then f n else 0) / (q.totient : ℂ)‖ := norm_sum_le _ _
    _ ≤ ∑ n ∈ S, 2 * ‖f n‖ := by
      apply Finset.sum_le_sum
