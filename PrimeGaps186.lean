      _ = 6 * Q ^ 2 := by ring
  have hsource :
      ‖∫ t in -U..U, dirichletExplicitFormulaIntegrand chi x
          (((-1 / 2 : ℝ) : ℂ) + t * I)‖ ≤
        720 * (A : ℝ) * Q ^ 2 := by
    calc
