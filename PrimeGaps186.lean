    exact_mod_cast (sub_eq_zero.mp (Finset.mem_filter.mp hrm).2).symm
  change F.card ≤ N.divisors.card
  apply Finset.card_le_card_of_injOn (fun rm : ℕ × ℕ => rm.1)
