      lam d ≠ 0 → mu e ≠ 0 →
        Nat.lcm W (Nat.lcm (∏ j, d j) (∏ j, e j)) ∈ Q)
    (hSource : ∀ a : ℕ, Nat.Coprime a (∏ p ∈ P, p) →
