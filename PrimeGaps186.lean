    if Int.ModEq ((s * p.1 : ℕ) : ℤ) (lam * p.2.2) (lamTilde * p.2.1) then
      U p.1 p.2.1 p.2.2 * φ p.1 * ψ p.2.1 * ψ p.2.2 else 0
  let g : ℤ × (ℕ × ℤ) → ℂ := fun p =>
