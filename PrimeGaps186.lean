      (mul_nonneg hC₀P (Real.rpow_nonneg hlog.le (ED + EN))),
      Real.norm_of_nonneg (Real.rpow_nonneg hx0.le (ε / 2)), one_mul] using hb x hxb
  have hdivisorLog :
      (32 : ℝ) ^ m.primeFactors.card * (1 + Real.log (m : ℝ)) ^ 2 ≤
