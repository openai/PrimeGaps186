  rw [hfactor.2.2.2]
  apply norm_sum_le_of_le
  intro g hg
  have hgroup :
      (∑ t ∈ 𝒜 g,
        c (g * t.2.1 * t.2.2.1, t.1) * star (c (g * t.2.2.2, t.1)) *
          ∑ ℓ ∈ L t.1,
            ∑ n ∈ γ.support.filter (fun n => n + ℓ * (t.1 : ℤ) ∈ γ.support),
              γ n * star (γ (n + ℓ * (t.1 : ℤ))) *
                ∑ h ∈ J g,
                  mixedFiberFourierCoefficient sm w
                    (g * t.2.1 * t.2.2.1) (g * t.2.2.2) t.1 a b₁ b₂
