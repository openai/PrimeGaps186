      simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat] using hvhalfR
    have hE : 1 ≤ E := by
      have ht := Finset.single_le_sum
        (f := fun k : ℕ => v ^ k / (k.factorial : ℚ))
        (fun k (_ : k ∈ Finset.range 129) =>
