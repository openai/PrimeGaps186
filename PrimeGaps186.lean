      (w : ℝ) * D / N ≤ 2 * x ^ (-(5 * ε)) →
      ∀ (φ ψ : ℝ → ℂ), ContDiff ℝ ∞ φ → ContDiff ℝ ∞ ψ →
      Function.support φ ⊆ Set.Icc (-TD) TD →
      Function.support ψ ⊆ Set.Icc (-TN) TN →
      (∀ (r : ℕ) (t : ℝ), ‖iteratedDeriv r φ t‖ ≤ Cφ r * (Real.log x) ^ Eφ r) →
      (∀ (r : ℕ) (t : ℝ), ‖iteratedDeriv r ψ t‖ ≤ Cψ r * (Real.log x) ^ Eψ r) →
      letI : NeZero m := ⟨hm.ne_zero⟩
      let L : ZMod m := A₂ * ((Jnum / (w₂ : ℤ) : ℤ) : ZMod m)
