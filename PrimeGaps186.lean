        sqrt_sqrt_natCast_eq_rpow_one_fourth hx]
      norm_num [← Real.rpow_add (show (0 : ℝ) < x by positivity)]

theorem sqrt_mul_vaughanCubeRoot_eq_rpow_five_sixths
    {x : ℕ} (hx : 1 ≤ x) :
