      0 < n ∧ (n : ℝ) ≤ 2 * x := by
    have hi := Finset.mem_Icc.mp (hmem n hn)
    have hlo : x ≤ (n : ℝ) :=
      hxu.trans ((Nat.le_ceil u).trans (Nat.cast_le.mpr hi.1))
    refine ⟨Nat.cast_pos.mp (hxpos.trans_le hlo), ?_⟩
    exact (Nat.cast_le.mpr hi.2).trans ((Nat.floor_le hvpos.le).trans hvx)
