      (M ^ 2 + M) *
        (96 * (τR : ℝ) * H * Real.sqrt b /
            (Real.sqrt Q * Real.sqrt Rlo) +
          72 * Real.sqrt Q * Real.sqrt Rhi / Real.sqrt b) := by
  intro J τR
  rcases R.eq_empty_or_nonempty with rfl | hRne
