      ∑ ℓ ∈ L, if IsUnit (ℓ : ZMod (s.val * Nat.lcm r₁.val r₂.val)) then
        ψ ((ℓ : ℝ) / H) *
          normalizedKloosterman3Mod (r₁.val * s.val)
