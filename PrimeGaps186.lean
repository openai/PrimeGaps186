  simp_rw [← centralPair_primeTuples_cons 1, centralPair_primeTuples_one] at h
  have htwo (p : ℕ) (r : Fin 2 → ℕ) : (Fin.cons p r : Fin 3 → ℕ) 2 = r 1 :=
    Fin.cons_succ (α := fun _ : Fin 3 => ℕ) p r (1 : Fin 2)
  simpa only [Fin.cons_zero, Fin.cons_one, htwo] using h

