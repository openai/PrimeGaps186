  intro a σclass γ₀ hlevel hsmooth hthree hdist L0 hL0 hL0sub
  have hσhalf : σclass < 1 / 2 := by dsimp only [σclass, a]; linarith only [hτ, hτsmall]
  let Good : Set ℝ := {e |
    1 / 2 + 2 * («ω» + e) < 59519 / 100000 - τ ∧
    1 / 4 + 7 * («ω» + e) + 2 * (δ + e) < γ₀ ∧
    1 / 18 + 28 / 9 * («ω» + e) + 2 / 9 * (δ + e) < 19 / 200 - τ ∧
    σclass + e < 1 / 2 ∧
    ((density = 1 ∧ 54 * («ω» + e) + 15 * (δ + e) + 5 * (σclass + e) < 1 ∧
        68 * («ω» + e) + 14 * (δ + e) < 1) ∨
      (density = 2 ∧ 56 * («ω» + e) + 16 * (δ + e) + 4 * (σclass + e) < 1 ∧
        68 * («ω» + e) + 14 * (δ + e) < 1) ∨
      (density = 3 ∧ 72 * («ω» + e) + 24 * (δ + e) < 1 ∧
        48 * («ω» + e) + 16 * (δ + e) + 4 * (σclass + e) < 1 ∧
        64 * («ω» + e) + 20 * (δ + e) + 2 * (σclass + e) < 1))}
  have hI1open : IsOpen {e : ℝ |
