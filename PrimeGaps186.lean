    _ ≤ (I.card : ℝ) * (K * (τ : ℝ)) *
        ∑ r ∈ R, ((S r).card : ℝ) * (((S r).sup id : ℕ) : ℝ) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
