theorem harmanB_largest_prime_split
    (p m : ℕ) (hp : Nat.Prime p) (hm : 0 < m)
    (hmax : ∀ t : ℕ, Nat.Prime t → t ∣ m → t < p)
    (j : Fin 2) (slo shi Z L U : ℝ) :
    let B : ℕ → ℤ := fun n =>
      ∑ a ∈ n.divisorsAntidiagonal, ∑ b ∈ a.2.divisorsAntidiagonal,
        if (if j = 0 then a.1 = 1 else Nat.Prime a.1) ∧
            slo ≤ (a.1 : ℝ) ∧ (a.1 : ℝ) ≤ shi ∧
            ((max 1 (b.1.primeFactors.sup id) : ℕ) : ℝ) < Z ∧
            L ≤ ((a.1 * b.1 : ℕ) : ℝ) ∧ ((a.1 * b.1 : ℕ) : ℝ) ≤ U
        then ArithmeticFunction.moebius b.1 else 0
    B (p * m) =
      ∑ a ∈ m.divisorsAntidiagonal, ∑ b ∈ a.2.divisorsAntidiagonal,
        ((if j = 1 ∧ a.1 = 1 ∧ slo ≤ (p : ℝ) ∧ (p : ℝ) ≤ shi ∧
            ((max 1 (b.1.primeFactors.sup id) : ℕ) : ℝ) < Z ∧
            L ≤ ((p * b.1 : ℕ) : ℝ) ∧ ((p * b.1 : ℕ) : ℝ) ≤ U
          then ArithmeticFunction.moebius b.1 else 0) +
         (if (if j = 0 then a.1 = 1 else Nat.Prime a.1) ∧
            slo ≤ (a.1 : ℝ) ∧ (a.1 : ℝ) ≤ shi ∧ (p : ℝ) < Z ∧
            L ≤ ((p * (a.1 * b.1) : ℕ) : ℝ) ∧
              ((p * (a.1 * b.1) : ℕ) : ℝ) ≤ U
          then -ArithmeticFunction.moebius b.1 else 0) +
         (if (if j = 0 then a.1 = 1 else Nat.Prime a.1) ∧
            slo ≤ (a.1 : ℝ) ∧ (a.1 : ℝ) ≤ shi ∧
            ((max 1 (b.1.primeFactors.sup id) : ℕ) : ℝ) < Z ∧
            L ≤ ((a.1 * b.1 : ℕ) : ℝ) ∧ ((a.1 * b.1 : ℕ) : ℝ) ≤ U
          then ArithmeticFunction.moebius b.1 else 0)) := by
  simpa only [Bool.false_eq_true, ite_false] using
    harmanB_signed_or_absolute_largest_prime_split
      p m hp hm hmax j false slo shi Z L U

end

