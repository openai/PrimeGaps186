    rw [← Real.logb_mul (hpos i).ne' (hpos k).ne',
      Real.logb_lt_iff_lt_rpow hx (mul_pos (hpos i) (hpos k))]
  have htriple (t : ℝ) :
      (t < Real.logb x (p 1 : ℝ) + Real.logb x (p 2 : ℝ) + Real.logb x (p 3 : ℝ) ↔
        x ^ t < (p 1 : ℝ) * p 2 * p 3) ∧
      (Real.logb x (p 1 : ℝ) + Real.logb x (p 2 : ℝ) + Real.logb x (p 3 : ℝ) ≤ t ↔
        (p 1 : ℝ) * p 2 * p 3 ≤ x ^ t) := by
    rw [← Real.logb_mul (hpos 1).ne' (hpos 2).ne',
      ← Real.logb_mul (mul_pos (hpos 1) (hpos 2)).ne' (hpos 3).ne',
      Real.lt_logb_iff_rpow_lt hx (mul_pos (mul_pos (hpos 1) (hpos 2)) (hpos 3)),
      Real.logb_le_iff_le_rpow hx (mul_pos (mul_pos (hpos 1) (hpos 2)) (hpos 3))]
