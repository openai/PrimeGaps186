        gcongr
      _ = (m.divisors.card : ℝ) ^ 5 := by ring
      _ = (32 : ℝ) ^ m.primeFactors.card := by
        rw [squarefree_card_divisors m hm]
        push_cast
        rw [pow_right_comm]
        norm_num
  have hdivisorProfile :
