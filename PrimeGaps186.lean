    Filter.eventually_all.mpr (fun t => hWsmall (ε t) (hε t))
  intro A hA
  obtain ⟨K₀, X₀, hK₀, hX₀, hsource₀⟩ := hsource (A + 2) (by linarith)
  refine ⟨C₁ * C₂ * K₀, mul_pos (mul_pos hC₁ hC₂) hK₀, ?_⟩
  filter_upwards [hcoefF, hcoefG, hsupportF, hsupportG, hWall, hWsmall εb hεb,
