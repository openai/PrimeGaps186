      ∑ r ∈ Finset.Ico 33 43, q r * rep (r + e.val + 1) :=
    (Finset.sum_Ico_eq_sub (fun r => q r * rep (r + e.val + 1)) (by omega)).symm
  have hcompare (a : ℕ) :
