    dsimp only [Dlo]
    rw [coeff_sum_monomial_eq_ite, ite_eq_left (Finset.mem_range.mpr hi)]
  have hAhi (i : ℕ) (hi : i < 98304) : Ahi.getD i 0 = Dhi.coeff i := by
    rw [show Ahi = Array.ofFn (fun a : Fin 98304 =>
