theorem sifted_short_geometric_profile_bounds (D : ℝ) (hD : 1 ≤ D) :
    ∃ B : ℕ → ℝ, (∀ r : ℕ, 0 < B r) ∧
      ∀ x : ℝ, Real.exp 1 ≤ x →
        let Θ := 1 + (Real.log x) ^ (-D)
