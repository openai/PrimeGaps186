      simpa only [Real.log_rpow hx0] using
        Real.log_le_log (zero_lt_one.trans_le hh1) hH
    dsimp only [k]
    rw [ite_eq_right hh]
    calc
      ((Nat.log 2 ⌊H⌋₊ + 1 : ℕ) : ℝ) ≤ 1 + Real.log H / Real.log 2 := hcount
      _ ≤ 1 + (4 * Real.log x) / Real.log 2 :=
        add_le_add_right (div_le_div_of_nonneg_right hlogs htwo.le) 1
      _ ≤ 2 * Real.log x + (4 * Real.log x) / Real.log 2 := by linarith only [hlog]
