    symm
    apply Finset.sum_subset hMfull
    intro m hm hnot
    have hlarge : NN / (Y + 1) < m := by
      apply lt_of_not_ge
      intro hcap
      have hm1 := (Finset.mem_Icc.mp (Finset.mem_filter.mp hm).1).1
      exact hnot (Finset.mem_filter.mpr
        ⟨Finset.mem_Icc.mpr ⟨hm1, hcap⟩, (Finset.mem_filter.mp hm).2⟩)
    have hempty (l u : ℕ) :
        Finset.Icc (max (Y + 1) l) (min (NN / m) u) = ∅ :=
      cofactor_clipped_prime_window_eq_empty NN Y m l u hlarge
    have hzero (b : Fin 3) (s d : ℕ) : Psum b m s d r = 0 := by
