      simp only [ab, dite_eq_left hq, ZMod.coe_unitOfCoprime, Int.cast_natCast]
    have hS : (∑ q ∈ Qset, η (q : ℕ) * R q (ab q : ZMod (q : ℕ))) = S b := by
      dsimp only [S]
      apply Finset.sum_congr rfl
      intro q hq
      rw [hab q hq, Int.cast_natCast]
