  have hxT : T ≤ x :=
    (le_max_of_le_right (le_max_of_le_right (le_max_right _ _))).trans hx
  have hxexp : Real.exp 1 ≤ x := (le_max_left _ _).trans hx
  have hxpos : 0 < x := by linarith
  have hℓ : 1 ≤ Real.log x := (Real.le_log_iff_exp_le hxpos).mpr hxexp
  have hℓpos : 0 < Real.log x := zero_lt_one.trans_le hℓ
