          512 * delta * (q1 : ℝ) ^ (delta / 2) *
            (Real.log (q1 : ℝ)) ^ 2 := by simpa [delta] using hLone
      _ ≤ 512 * delta * (q : ℝ) ^ (delta / 2) *
          (Real.log (q : ℝ)) ^ 2 := by
        gcongr
