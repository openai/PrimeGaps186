  have hT (a : ℕ) : 0 ≤ T.coeff a := by
    change 0 ≤ ((∑ r ∈ Finset.range 33,
        q r * eulerianCarryPolynomial (r + e.val + 1)) +
      ∑ r ∈ Finset.Ico 33 43, q r * rep (r + e.val + 1)).coeff a
