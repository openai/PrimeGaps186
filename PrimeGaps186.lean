        (Q : ℝ) * (1 + Real.log (Q : ℝ)) ^ (2 ^ J - 1) :=
    (Finset.sum_le_sum_of_subset_of_nonneg hS (fun q _ _ => by positivity)).trans
      (sum_card_divisors_pow_le_mul_log_pow J Q)
