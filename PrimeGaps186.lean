    rw [Finset.mem_Icc, Nat.ceil_le, Nat.le_floor_iff (by positivity)]
    push_cast
    rfl
  simp only [sourceT5CentralTuples, Finset.mem_filter, hmem, true_and, hcarrier]
  rw [horder 3 2, horder 2 1, horder 1 0]
  simp only [hlow, hlt, hpair, (htriple ((40481 : ℝ) / 100000)).1,
    (htriple ((59519 : ℝ) / 100000)).2]
  simp [sourceT5CentralMonomialCuts, MinorantMonomialCut.value,
