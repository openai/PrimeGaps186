open Classical in
theorem typeIII_sampled_transform_fineBand_taylor
    (B ε C T E : ℝ) (hB : 0 ≤ B) (hε : 0 < ε)
    (hC : 1 ≤ C) (hT : 0 ≤ T) :
    let J : ℕ := Nat.ceil (2 * (B + 1) / ε)
