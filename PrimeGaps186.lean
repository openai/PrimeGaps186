  let gate : (Fin 39 → ℕ) → (Fin 39 → ℕ) → Prop := fun d e =>
    (∀ a b : Fin 39, a ≠ b → Nat.Coprime (d a) (e b)) ∧ lam d ≠ 0 ∧ mu e ≠ 0
  let r : (p : P) → Fin 39 → ZMod (p : ℕ) := fun p j =>
    if (p : ℕ) ∣ W then ((v + h i : ℕ) : ZMod (p : ℕ))
    else (h i : ZMod (p : ℕ)) - (h (i.succAbove j) : ZMod (p : ℕ))
