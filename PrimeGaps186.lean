theorem trial_actual_signed_restoration :
    let μ₄₀ := Measure.pi (fun _ : Fin 40 => trialPhysicalMeasure)
    let μ₃₉ := Measure.pi (fun _ : Fin 39 => trialPhysicalMeasure)
    let α : ℝ := (∫ X,
      ((1 - physicalSourceOuterSupport X) * trialStepFunction X) ^ 2 ∂μ₄₀) /
