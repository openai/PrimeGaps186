    have hh := Real.log_le_log hq₀R hq₀Q
    rw [Real.log_mul (by norm_num) hQ.ne'] at hh
    nlinarith only [hh, hlog2, hlogQ, hlogNlo, hlogx]
  have hP (t : ℕ × ℕ) (ht : t ∈ F) (s : ℕ × ℕ) (hs : s ∈ F) :
