    let beta : ℝ := 1 - ∑ i, t i
    let w : ℝ := (q : ℝ) * P / x
    (∀ i, (9519 : ℝ) / 50000 ≤ t i ∧ t i ≤ (6 : ℝ) / 25) ∧
