  · have hp : 0 < (2 : ℕ) ^ (Nat.log 2 ⌊H⌋₊ + 1) := pow_pos (by decide) _
    have hb : ⌊B⌋ = (2 : ℤ) ^ k - 1 := by
      dsimp only [B, k]
      simp only [ite_eq_right hH]
      rw [Int.floor_natCast, Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr hp.ne'),
        Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one]
    rw [hb]
    ext z
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_erase, Finset.mem_Ioo]
