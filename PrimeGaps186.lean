  have hExp := log_exp_three_mul_vaughanCubeRoot_le hx
  have hbase0 : 0 ≤ 1 / 3 + 3 / (2 * Real.log 2) := by positivity
  have hlowFirst : (4 / 3 : ℝ) ^ 2 ≤
