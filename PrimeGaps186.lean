    _ ≤ ∑ t ∈ 𝒜, (M * (q₀ : ℝ) / (R * Q ^ 2)) * w t.1 t.2.2 := Finset.sum_le_sum hrow
    _ = (M * (q₀ : ℝ) / (R * Q ^ 2)) * ∑ t ∈ 𝒜, w t.1 t.2.2 := (Finset.mul_sum ..).symm
    _ ≤ (M * (q₀ : ℝ) / (R * Q ^ 2)) *
        ((2 * R) * (K * Q ^ 2 * N * (Int.gcd (q₀ : ℤ) ℓ : ℝ) /
