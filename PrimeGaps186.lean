      _ = T ^ 2 := by ring
  change |Real.log x / x * (∑ p ∈ P, ∑ q ∈ Q p, N p q) -
    (v - u) * (∑ p ∈ P, ∑ q ∈ Q p, W p q)| ≤ _
  calc
    _ = |∑ p ∈ P, ∑ q ∈ Q p, (Real.log x / x * N p q - (v - u) * W p q)| := by
      simp_rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
    _ ≤ ∑ p ∈ P, |∑ q ∈ Q p, (Real.log x / x * N p q - (v - u) * W p q)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ P, ∑ q ∈ Q p, |Real.log x / x * N p q - (v - u) * W p q| :=
      Finset.sum_le_sum fun _ _ => Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ P, ∑ q ∈ Q p, (K / ((p : ℝ) * q * Real.log x) + Real.log x / x) :=
      Finset.sum_le_sum fun p hp => Finset.sum_le_sum (hpoint p hp)
