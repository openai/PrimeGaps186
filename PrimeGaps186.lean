    · simp [hdq]
  rw [Finset.sum_congr rfl (fun m hm => hsplit m (Finset.mem_Icc.mp hm).2),
    Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro q hq
  have hqPrime := Nat.prime_of_mem_primesLE (Finset.mem_filter.mp hq).1
  rw [sum_real_Icc_divisorsAntidiagonal_fixed
    A B q hA hAB hqPrime.pos (fun r => if q ≤ r ∧ r.Prime then 1 else 0)]
  rw [← Finset.sum_filter]
  have hsets :
      (Finset.Icc (Nat.ceil (A / (q : ℝ))) (Nat.floor (B / (q : ℝ)))).filter
          (fun r => q ≤ r ∧ r.Prime) =
        (Finset.Icc (max q (Nat.ceil (A / (q : ℝ))))
            (Nat.floor (B / (q : ℝ)))).filter Nat.Prime := by
    ext r
