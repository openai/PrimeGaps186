          ((n : ZMod r) * ((z * q₂ : ℕ) : ZMod r)) *
        reciprocalUnitPhase z ((b₁ : ZMod z) * (h : ZMod z))
          ((n : ZMod z) * ((r * q₂ : ℕ) : ZMod z)) *
        reciprocalUnitPhase q₂ ((b₂ : ZMod q₂) * (h : ZMod q₂))
