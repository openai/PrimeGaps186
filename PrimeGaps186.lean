    rw [htransport]
    calc
      _ ≤ ∑ m ∈ α.support with Nat.Coprime m (q * r), ‖α m‖ * V := by
        apply norm_sum_le_of_le
        intro m hm
        exact norm_mul_le_of_le le_rfl
          (hζ (l₀ ⌈/⌉ m) (u₀ / m) (b m)
            (hprimitive m (Finset.mem_filter.mp hm).2.coprime_mul_right_right))
      _ ≤ V * ∑ m ∈ α.support, ‖α m‖ := by
        rw [mul_comm V, Finset.sum_mul]
        exact Finset.sum_mono_set_of_nonneg
          (fun m => mul_nonneg (norm_nonneg _) hV) (Finset.filter_subset _ _)
  have huniv : (Finset.univ : Finset (Fin k)).Nonempty :=
    ⟨⟨0, hk⟩, Finset.mem_univ _⟩
  refine ⟨?_, ?_, ?_⟩
  · intro n hn
    obtain ⟨hlo, hup⟩ := hsupportProd Finset.univ n (Finset.mem_of_mem_filter n hn)
    simp only [Finset.card_fin] at hlo hup
    have hpow : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ K :=
