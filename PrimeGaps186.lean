      ∀ (u v F G ell dstar nstar Jnum : ℤ),
      IsUnit (u : ZMod m) → IsUnit (v : ZMod m) → (w₂ : ℤ) ∣ Jnum →
      ∀ (A₁ A₂ B : ZMod m), IsUnit A₁ → IsUnit A₂ →
