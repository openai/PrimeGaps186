    _ = (vaughanPrimitiveMeanConstant A *
          vaughanPrimitiveMeanLogPower x) *
        ∫ t in Set.Ioc Q1 Q,
          vaughanPrimitiveMeanPolynomial x t / t ^ 2 := by
      rw [integral_const_mul]

theorem primitiveRawMeanValue_lowerBoundary_nonpos
