        4 * Real.sqrt (N : ℝ) * Real.log (N : ℝ) := by
    have hφ : (1 : ℝ) ≤ q.totient := by exact_mod_cast Nat.totient_pos.mpr hq0
    have hterm (n : ℕ) :
        ‖(if n % q = a q % q then (primePowerError n : ℂ) else 0) -
