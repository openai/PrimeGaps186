            ‖fullDiscrepancy (D 0) q (a' x a q)‖ +
              ‖fullDiscrepancy (D 1) q (a' x a q)‖ := by
        rw [hΔ]
        exact (norm_sub_le _ _).trans
          (add_le_add (norm_sub_le _ _) (le_refl _))
