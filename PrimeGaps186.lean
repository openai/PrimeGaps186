      (B.card : ℝ) * g * (1 + (T : ℝ) / (q₀ : ℝ)) * W ^ 4 ≤
        J * (Real.log x) ^ (4 * E) * x ^ (η / 2) * P := by
    calc
      _ ≤ (Cr * Cu * Cq * R * U * Q / (q₀ : ℝ)) * g *
          ((1 + Cβ) * N / (q₀ : ℝ)) * W ^ 4 :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul (mul_le_mul_of_nonneg_right hcard hg) hremainder
            (by positivity) (by positivity)) (pow_nonneg hW 4)
