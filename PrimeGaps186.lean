    (h : ∀ p ∈ activatedPrimeFactors R ξ D,
      ((primeFragmentSuffix R D p + logFragment R p + φ (logFragment R p) : ℝ≥0) : ℝ) ≤ A ∧
        (ψ (logFragment R p) : ℝ) ≤ C) :
    (primeFragmentOwner φ R ξ D : ℝ) ≤ A ∧ (ψ (maxActivatedPrimeFragment R ξ D) : ℝ) ≤ C := by
  classical
  have howner : primeFragmentOwner φ R ξ D ≤ (⟨A, hA⟩ : ℝ≥0) :=
    Finset.sup_le fun p hp => by exact_mod_cast (h p hp).1
  refine ⟨by exact_mod_cast howner, ?_⟩
