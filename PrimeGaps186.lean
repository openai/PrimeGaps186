          _ ≤ 2 * (K * M * N * (Int.gcd (g : ℤ) ℓ : ℝ) /
              (g : ℝ) * x ^ (-3 * ε / 2)) := by linarith
          _ = _ := by dsimp only [P]; ring
      _ = (((bins g).card : ℝ) * (k g : ℝ)) *
          (2 * P * ((Int.gcd (g : ℤ) ℓ : ℝ) / (g : ℝ))) := by
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
