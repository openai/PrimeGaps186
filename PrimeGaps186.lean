        Squarefree (t.1 * g * t.2.1 * t.2.2.1 * t.2.2.2) ∧
        Nat.Coprime (t.1 * g * t.2.1 * t.2.2.1 * t.2.2.2) (a * b₁ * b₂) := by
      intro t ht
      obtain ⟨hr, hu, hv, hq₂, _, _, _, _, hsq, hp⟩ :=
        (hfactor.1 g hg).2 t (Finset.mem_filter.mp ht).1
      exact ⟨hr, hu, hv, hq₂, hsq, hp⟩
    simpa only [K, F] using factoredMixedFourier_sourcePhiTheta
      cM TM M hcM hcMT hM ψM hsupport (block g ℓ i) β c g a b₁ b₂ ℓ (J g) hblock
  have hlinear (g : ℕ) (ℓ : ℤ) (D : Finset (ℕ × ℕ × ℕ × ℕ)) (J' : Finset ℤ) :
      F g ℓ D J' = ∑ h ∈ J', F g ℓ D {h} := by
    dsimp only [F]
    simp only [Finset.sum_singleton, Finset.mul_sum]
    exact (Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)).trans Finset.sum_comm
  have hshell (g : ℕ) (ℓ : ℤ) (D : Finset (ℕ × ℕ × ℕ × ℕ)) :
