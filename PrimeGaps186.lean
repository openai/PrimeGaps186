theorem sourceU3_diagonal_moduli_log_saving (J : ℕ) (A : ℝ) (hA : 0 < A) :
    ∃ K X : ℝ, 0 < K ∧ Real.exp 100 ≤ X ∧
      ∀ x : ℝ, X ≤ x →
