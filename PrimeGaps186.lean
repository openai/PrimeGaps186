theorem goldfeldSmoothedSummand_nonneg
    {q1 q : ℕ}
    (chi1 : DirichletCharacter ℂ q1)
    (chi : DirichletCharacter ℂ q)
    (hsquare1 : chi1 ^ 2 = 1) (hsquare : chi ^ 2 = 1)
    (beta x : ℝ) (n : ℕ) :
    0 ≤ goldfeldBetaCoefficient chi1 chi beta n *
      (goldfeldPlateau ((n : ℝ) / x) : ℂ) := by
