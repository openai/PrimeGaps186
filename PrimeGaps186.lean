        ((MeromorphicOn.divisor (inducingEulerProduct chi)
          (closedBall ((2 : ℂ) + t * I) 3)).support.ncard : ℝ) := by
    exact_mod_cast hnat
  exact hreal.trans
    (ncard_support_divisor_inducingEulerProduct_radiusThree_le chi t)

