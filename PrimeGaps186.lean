        (∑ x : ZMod q, w x) * (∑ x : ZMod q, F x) / (q : ℂ)‖ ≤
      ((6 : ℝ) ^ q.primeFactors.card * Real.sqrt (q : ℝ)) / (q : ℝ) *
        ∑ ξ ∈ (Finset.univ : Finset (ZMod q)).erase 0, ‖ZMod.dft w ξ‖) ∧
