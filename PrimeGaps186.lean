    repeated_factor_polynomial_band_moduli_log_saving J A hA
  refine ⟨K, max X (Real.exp 100), hK, le_max_right _ _, ?_⟩
  intro x hx α U E P T B Fdiag S hS a ha
  have hx1 : 1 < x :=
