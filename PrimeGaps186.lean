      (norm_sum_le _ _).trans
        (minorantHB_three_box_family_coefficient_norm_sum_le
          A B t U Θ hA hAB hΘ hΘtwo ht htten r (rejected r)
          (Finset.filter_subset _ _) n)
    rw [hR]
    by_cases hn : x ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * x
    · rw [ite_eq_left hn]
      calc
        _ ≤ ∑ r : Fin 3 → Fin 5, ‖a r * ∑ ν ∈ rejected r, β r ν n‖ :=
          norm_sum_le _ _
        _ ≤ ∑ r : Fin 3 → Fin 5, ‖a r‖ * H := by
          apply Finset.sum_le_sum
          intro r _
          rw [norm_mul]
          exact mul_le_mul_of_nonneg_left (hsum r) (norm_nonneg _)
