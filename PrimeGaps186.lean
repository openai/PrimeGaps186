    (hpair hpair12) (hpair hpair13) (hpair hpair23)
    (hupper hupper₁) (hupper hupper₂) (hupper hupper₃)
    Y hY Qset hQset ((3 : ℝ) ^ 40) Lder Lder Lder
    (by positivity) hLder.le hLder.le hLder.le α hαwindow hαgrowth
