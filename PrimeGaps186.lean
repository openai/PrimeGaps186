      (div_le_div_of_nonneg_right hsourceNumerator hTpos.le)
    simpa [a, b, L, Q] using hfinal
  · have hfinal := hselectedLower.trans
      (div_le_div_of_nonneg_right hsourceNumerator hTpos.le)
    simpa [a, b, L, Q, sub_eq_add_neg] using hfinal

end

