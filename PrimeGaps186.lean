  have hroot (j : ℕ) : Real.sqrt ((2 : ℝ) ^ j) = s ^ j := by
    simpa [s, NNReal.sqrtHom] using
      congrArg NNReal.toReal (map_pow NNReal.sqrtHom (2 : NNReal) j)
  have hinvnonneg : 0 ≤ s⁻¹ := inv_nonneg.mpr hspos.le
  have hinvle : s⁻¹ ≤ (3 : ℝ) / 4 := by
    rw [inv_eq_one_div, div_le_iff₀ hspos]
    nlinarith [hslo]
  have hinvlt : s⁻¹ < 1 := inv_lt_one_of_one_lt₀ hsone
