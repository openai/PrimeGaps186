theorem largest_prime_windows_fixedPower_siegelWalfisz
    (D B H T A : ℝ) (hD : 0 < D) (hH : 0 ≤ H) (hT : 0 ≤ T) :
    ∃ K X0 : ℝ, 0 < K ∧ Real.exp 1 ≤ X0 ∧
      ∀ x : ℝ, X0 ≤ x → ∀ N : ℝ, 0 ≤ N →
