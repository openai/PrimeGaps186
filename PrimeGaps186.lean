            ‖F g ℓ (block g ℓ i) (Jneg j)‖) := by
  intro sm w J Ω G 𝒜 γ L Lall hLall bins block F Jpos Jneg
  have hfactor := mixedFourier_offDiagonal_gcd_shift_factorization
    sm w S β c a b₁ b₂ J u hS hprim hu
  let K : ℕ → ℤ → (ℕ × ℕ × ℕ × ℕ) → ℂ := fun g ℓ t =>
    c (g * t.2.1 * t.2.2.1, t.1) * star (c (g * t.2.2.2, t.1)) *
      ∑ n ∈ γ.support.filter (fun n => n + ℓ * (t.1 : ℤ) ∈ γ.support),
        γ n * star (γ (n + ℓ * (t.1 : ℤ))) *
          ∑ h ∈ J g,
            mixedFiberFourierCoefficient sm w
              (g * t.2.1 * t.2.2.1) (g * t.2.2.2) t.1 a b₁ b₂
              n.toNat (n + ℓ * (t.1 : ℤ)).toNat
