          (![3 * (1 - z 0 - z 1) / 5, 4 * (z 1 - z 2) / 5,
            -2 * (1 + z 1 + 2 * z 3) / 5, 4 * (1 + z 1 + z 2 + z 3) / 5,
            3 * (z 0 - z 1) / 5] : Fin 5 → ℝ)
          (fun k => minorantVertices1 (minorantSimplexIndices1 2 k))
        · intro k
