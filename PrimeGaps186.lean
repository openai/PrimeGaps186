  have haunit (q : ℕ+) (hq : q ∈ Qset) : IsUnit ((a : ℤ) : ZMod (q : ℕ)) := by
    rcases Finset.mem_image.mp hq with ⟨r, _, rfl⟩
    change IsUnit ((a : ℤ) : ZMod r.val)
    simpa only [Int.cast_natCast] using
