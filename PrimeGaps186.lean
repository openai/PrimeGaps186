      simpa only [Nat.cast_mul, mul_assoc, mul_left_comm, mul_comm] using hrel
    · dsimp only [kOf]
      apply Int.ediv_eq_of_eq_mul_right
        (mul_ne_zero (NeZero.ne (s : ℤ)) (NeZero.ne (d : ℤ)))
      simpa only [mul_assoc, mul_left_comm, mul_comm] using hrel
  have hcard : K.card ≤ D.card * I.card ^ 2 := by
    calc
      K.card ≤ T.card := Finset.card_image_le
      _ ≤ (D ×ˢ (I ×ˢ I)).card := Finset.card_filter_le _ _
      _ = D.card * I.card ^ 2 := by simp only [Finset.card_product, pow_two]
  have hK : ∀ k ∈ K, ∃ d ∈ D, ∃ n ∈ I, ∃ nt ∈ I,
      lam * nt - lamTilde * n = (s : ℤ) * k * (d : ℤ) ∧
        lam ∣ lamTilde * n + (s : ℤ) * k * (d : ℤ) ∧
        ntOf k d n = nt ∧ U d n nt * φ d * ψ n * ψ nt ≠ 0 := by
    intro k hk
