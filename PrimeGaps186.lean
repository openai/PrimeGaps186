    have hsub : Rs ⊆ Finset.Icc 1 ⌊2 * R⌋₊ := by
      intro r hr
      obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hr
      obtain ⟨_, hr, _, _, _, _, hrR, _, _, _, _⟩ := h𝒜 t ht
      exact Finset.mem_Icc.mpr ⟨hr, (Nat.le_floor_iff (by positivity)).mpr hrR⟩
