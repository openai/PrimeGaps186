    · have ht := htypeIIBoxes x hxt l (scale ν 0) (scale ν 1)
        hMNlo hMNone.2 (hscale ν 1) (by
          have he : (1 / 2 : ℝ) - σ = a₀ - τ := by dsimp only [σ]; ring
          simpa only [he] using hmiddle) hMhi I hI a ha
