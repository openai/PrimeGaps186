  intro x hx m q₀ c₁ c₂ f w₃ hm hmx hq₀ hc₁ hc₂ u v F G h ell dstar nstar
    hu hv hw₃ A B L D N d₀ n₀ hD hN ψD ψN hψD hψN hsupportD hsupportN hboundD hboundN
  let : NeZero m := ⟨hm.ne_zero⟩
  have hx2 : 2 ≤ x := (le_max_left 2 b).trans ((le_max_right _ _).trans hx)
  have hxb : b ≤ x := (le_max_right 2 b).trans ((le_max_right _ _).trans hx)
