        simp only [Finset.mem_filter]
        exact ⟨fun h => ⟨hsub h, h⟩, fun h => h.2⟩
      _ = ∑ ℓ ∈ Lall, ∑ t ∈ (𝒜 g).filter (fun t => ℓ ∈ L t.1), K g ℓ t := by
        rw [Finset.sum_comm]
        simp only [Finset.sum_filter]
      _ = _ := by
        refine Finset.sum_congr rfl fun ℓ _ => ?_
        have hfiber := Finset.sum_fiberwise_of_maps_to
          (s := (𝒜 g).filter (fun t => ℓ ∈ L t.1)) (t := bins g)
          (g := fun t => Nat.log 2 t.2.1)
          (fun t ht => Finset.mem_image_of_mem (fun t => Nat.log 2 t.2.1)
            (Finset.mem_filter.mp ht).1) (K g ℓ)
        simpa only [block, Finset.filter_filter] using hfiber.symm
