  have hb₂q : Nat.Coprime b₂ q₀ := hqb.symm.of_dvd_left ⟨a * b₁, by ring⟩
  have hE := sourceCompatibility_residueFamily_exact q₀ r₁ b₁ b₂ ℓ
    ((hrq.mul_left hb₁q).mul_left hb₂q)
