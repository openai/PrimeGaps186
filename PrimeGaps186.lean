            (∑ r ∈ Finset.range 33, q r * rep (r + e.val + 1)))).coeff a at hb
    rw [htail] at hb
    exact hb.2
  have hper (r : ℕ) :
      ∀ a, 0 ≤ (mark ^ e.val * q r * eulerianCarryPolynomial (r + e.val + 1)).coeff a :=
    envelope_coeff_mul_nonneg (mark ^ e.val * q r)
