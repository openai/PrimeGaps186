      have hfirst : t.1 = s.1 := congrArg (fun p : ℕ × ℕ × ℕ => p.1) heq
      have hsecond : t.2.1 = s.2.1 := congrArg (fun p : ℕ × ℕ × ℕ => p.2.1) heq
      have hfourth : t.2.2.2 = s.2.2.2 := by
        simpa only [π] using congrArg (fun p : ℕ × ℕ × ℕ => p.2.2) heq
