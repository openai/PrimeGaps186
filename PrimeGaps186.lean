                    ((h : ZMod (t.1 * g * t.2.1 * t.2.2.1 * t.2.2.2)).val)) =
        ∑ ℓ ∈ Lall, ∑ i ∈ bins g, F g ℓ (block g ℓ i) (J g) := by
