  let D : ℝ := ((9519 : ℝ) / 50000) ^ 4 * (1 - 4 * ((9519 : ℝ) / 50000))
  change exceptionalMassCoefficient j ≤ D⁻¹ * volume.real R
  have hR : MeasurableSet R := exceptionalCut_measurable j
  have hfinite : volume R < ⊤ :=
    measure_lt_top_of_subset
      (fun t ht => mem_exceptional_exponent_box_of_snoc_lower_bounds ht.1)
