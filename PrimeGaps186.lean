  have hlog2 : Real.log 2 ≤ (1 / 100 : ℝ) * Real.log x :=
    hconst 2 (by norm_num) (by linarith only [hC])
  have hlog8 : Real.log 8 ≤ (1 / 100 : ℝ) * Real.log x :=
    hconst 8 (by norm_num) (by linarith only [hC])
  have hlog32 : Real.log 32 ≤ (1 / 100 : ℝ) * Real.log x :=
    hconst 32 (by norm_num) (by linarith only [hC])
  have hlogN : Real.log N = γ * Real.log x := by rw [hNγ, Real.log_rpow hxpos]
  have hlogNlo : (5 / 12 : ℝ) * Real.log x ≤ Real.log N := by
