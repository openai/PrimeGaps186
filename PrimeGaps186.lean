open Classical in
theorem sifted_short_geometric_profiles :
    ∃ B : ℕ → ℝ, (∀ r : ℕ, 0 < B r) ∧
      ∀ Θ : ℝ, 1 < Θ → Θ ≤ 2 →
        let η : ℝ → ℝ := fun u =>
          if 0 < u then
            Real.smoothTransition (Real.log u / Real.log Θ + 1) -
              Real.smoothTransition (Real.log u / Real.log Θ)
          else 0
        ContDiff ℝ ∞ (fun u => (η u : ℂ)) ∧
          Function.support (fun u => (η u : ℂ)) = Set.Ioo Θ⁻¹ Θ ∧
