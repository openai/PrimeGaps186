  obtain ⟨Xl, hXl⟩ := Filter.eventually_atTop.mp hlarge
  refine ⟨max Ks 1, max Xs Xl,
    hKs.trans_le (le_max_left _ _), hXs.trans (le_max_left _ _), ?_⟩
