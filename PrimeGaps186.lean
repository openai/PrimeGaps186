  have hprime (p : ℕ) (hp : p ∈ P) : p.Prime :=
    (Finset.mem_filter.mp hp).2
  have hpi {n : ℕ} (t : Fin n → Finset ℕ) (dec : DecidableEq (Fin n)) :
