    (hδ : 0 < δ) (hC : 1 ≤ C) (hT : 0 ≤ T)
    (hσ : 1 / 18 + 28 / 9 * omegaExp + 2 / 9 * δ < σ) :
    let μ : ℝ := 3 * σ / 4 - 7 * omegaExp / 3 - δ / 6 - 1 / 24
    let γ : ℝ := 1 / 2 + δ - 6 * omegaExp
    let εcap : ℝ := min (1 / 100) (min (μ / 8) (γ / 12))
