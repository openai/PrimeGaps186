          if (∏ i, p i) ∈ Finset.Icc (Nat.ceil (u * x)) (Nat.floor (v * x)) ∧
              (if j.val = 0 then
                (9519 : ℝ) / 50000 ≤ alpha 3 ∧
                alpha 3 < alpha 2 ∧ alpha 2 < alpha 1 ∧ alpha 1 < alpha 0 ∧
                alpha 0 < (40481 : ℝ) / 100000 ∧
                alpha 0 + alpha 1 < (40481 : ℝ) / 100000 ∧
                (59519 : ℝ) / 100000 < alpha 1 + alpha 2 + alpha 3 ∧
                (p 3 : ℝ) ≤ (p 4 : ℝ)
              else
