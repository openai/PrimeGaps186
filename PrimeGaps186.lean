      if Int.gcd (s : ℤ) ((m : ℤ) * lam * lamTilde) = 1 then ‖S₅‖ else 0 := by
    rw [hFsum]
    split_ifs <;> simp only [norm_zero]
  exact ⟨hzpos, hwz, hs, hzm, hqdiv, hc₁div, hc₂div, hy, hy', hlam, hlamTilde,
    hΛ, hlamBand, hlamTildeBand, hw₂lam, hw₂lamTilde, hAnonneg, hAnlt,
    hBnnonneg, hBnlt, hA, hAunit, hB, hEn, hCn, hφ, hψ, hφsupport,
    hψsupport, hderiv, hφeval, hDimage, hD, hI, hSsum, hSiter, hFzero,
    hFhas, hFsum, hnonzero, hnorm⟩

end

