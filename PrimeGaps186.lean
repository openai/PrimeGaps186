theorem opening_padded_window (H : ℝ) :
    let k : ℕ := if H < 1 then 0 else Nat.log 2 ⌊H⌋₊ + 1
    let B : ℝ := if H < 1 then 1 / 2 else ((2 ^ (Nat.log 2 ⌊H⌋₊ + 1) - 1 : ℕ) : ℝ)
