  have hlog : 0 ≤ Real.log x := by
    have := (Real.le_log_iff_exp_le hx0).mpr hxexp
    linarith
  have hN : 0 ≤ N := (Real.rpow_pos_of_pos hx0 ε).le.trans hNL
  have hden : 0 ≤ (Real.log x) ^ A := Real.rpow_nonneg hlog A
  have hqr0 : q * r0 ≠ 0 := Nat.mul_ne_zero hq.ne' hr0.ne'
  have hτq : (q.divisors.card : ℝ) ≤ ((q * r0).divisors.card : ℝ) := by
