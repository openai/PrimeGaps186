  obtain ⟨hm, hp, hcut⟩ := physicalSource_fixed_cutoffs g
  by_cases hlow : physicalSourceComponentKind g j = 0
  · have he : (0 : ℝ) < (e.1 : ℝ) := by
      exact_mod_cast (hcut j hj).1 (by omega : physicalSourceComponentKind g j < 2)
    let L : (Fin d → FiniteMeasure ℝ) → ℝ := fun X =>
      ∑ i : Fin d, (X i : Measure ℝ).real (Set.Ioc (0 : ℝ) (e.1 : ℝ))
    let T : ℝ := ((P.order : ℝ) - 1) * (e.2 : ℝ) - (P.threshold : ℝ)
    let θ : ℝ := (physicalSourceTheta g j : ℝ)
