    Finsupp.single n (c n * ψ ((n : ℝ) / N))
  have hMass (pred : ℕ → Prop) [DecidablePred pred] :
      (f.filter (fun n => Nat.Coprime n r)).sum (fun n t => if pred n then t else 0) =
