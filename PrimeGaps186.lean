theorem maskedReciprocalProduct_integer_interval_completion
    (q : ℕ) [NeZero q] (hq : Squarefree q)
    (M : (p : q.primeFactors) → Finset (ZMod p.1))
    (a : (p : q.primeFactors) → ZMod p.1 → ZMod p.1)
    (hM : ∀ p : q.primeFactors, (M p).card ≤ 2)
    (hactive : ∀ p : q.primeFactors, ∃ z ∈ M p, a p z ≠ 0)
