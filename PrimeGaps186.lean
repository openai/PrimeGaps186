    calc
      (q : ℝ) ^ ((1 : ℝ) / 2 - s.re) *
            ‖DirichletCharacter.LFunction chi⁻¹ (1 - s)‖ *
          ‖DirichletCharacter.gammaFactor chi⁻¹ (1 - s) /
            DirichletCharacter.gammaFactor chi s‖ ≤
          (q : ℝ) ^ 2 *
