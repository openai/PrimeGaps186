theorem selected_radiusTwo_riemannZeta₁_subdivisor_sum_le_re_analyticOrder_finsum
    (t : ℝ) (s : ℂ) (hs : 1 ≤ s.re) (Z : ℂ →₀ ℕ)
    (hZ : ∀ rho : ℂ,
      Z rho ≤
        if dist rho ((2 : ℂ) + t * I) ≤ 2 then
          analyticOrderNatAt riemannZeta₁ rho
        else 0) :
