theorem sourceSecondary_crt_and_compatibility_family
    (r₁ q₀ u₁ v₁ v₂ q₂ a b₁ b₂ : ℕ)
    (hpos : 0 < r₁ ∧ 0 < q₀ ∧ 0 < u₁ ∧ 0 < v₁ ∧ 0 < v₂ ∧ 0 < q₂)
