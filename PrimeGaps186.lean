  let c₁ : ℝ := 12 * (τR : ℝ) * H * Real.sqrt b / Real.sqrt Q
  let c₂ : ℝ := 18 * Real.sqrt Q / Real.sqrt b
  have hc₁ : 0 ≤ c₁ := by
