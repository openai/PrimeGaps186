theorem exceptionalPrimeDefect_interval_mass_coefficient :
    ∀ epsilon : ℝ, 0 < epsilon →
      ∀ᶠ x : ℝ in Filter.atTop,
        ∀ (j : Fin 2) (u v : ℝ),
          1 ≤ u → u ≤ v → v ≤ 2 →
            |Real.log x / x *
                (∑ n ∈ Finset.Icc (Nat.ceil (u * x)) (Nat.floor (v * x)),
