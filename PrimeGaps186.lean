  let lo : ℚ :=
    (((firstOuterLowExpDyadicPrefix 98303).getD a (2 ^ 640, 2 ^ 640)).1 : ℚ) / (2 ^ 640 : ℚ)
  let hi : ℚ :=
    (((firstOuterLowExpDyadicPrefix 98303).getD a (2 ^ 640, 2 ^ 640)).2 : ℚ) / (2 ^ 640 : ℚ)
  let hq : ℚ := 2742997 / 258046918656
  have hhq : 0 < hq := by norm_num [hq]
  have hh : (hq : ℝ) = h := by norm_num [hq, h]
  have hD1 : D.1 = hq * J.1 * lo := rfl
  have hD2 : D.2 = hq * J.2 * hi := rfl
  have hla : 0 ≤ lo := hex.2.1.le
  have hdd : 0 ≤ d := (hsel.1.trans_le hsel.2.1).le
  have hja : 0 ≤ J.1 := hsel.1.le
  have hJa : J.1 ≤ J.2 := (hsel.2.1).trans hsel.2.2.1
  have hLo : lo ≤ hi := hex.2.2.1
