    (∑ n ∈ I, if Nat.ModEq (W x) n v then
        b x n * (A F x n - C G x n) ^ 2 else 0) ≤
        ∑ n ∈ I, ((if Nat.ModEq (W x) n v then
          b x n * (C F x n - C G x n) ^ 2 else 0) + t n) :=
      Finset.sum_le_sum hpoint
    _ = (∑ n ∈ I, if Nat.ModEq (W x) n v then
          b x n * (C F x n - C G x n) ^ 2 else 0) + tail x := by
      rw [Finset.sum_add_distrib, htsum]
    _ ≤ (ρ * (17 / 50 : ℝ) * energy + ε / 2) *
          (x / (W x : ℝ) / B x ^ 40) +
        (ε / 2) * (x / (W x : ℝ) / B x ^ 40) :=
      add_le_add (herasedx v) hsmallTail
    _ = (ρ * (17 / 50 : ℝ) * energy + ε) * (x / (W x : ℝ) / B x ^ 40) := by ring

