theorem theta2_three_prime_interval_eq_sorted_prime_counts
    (x u v : ℝ) (hx : 1 < x) (hu : 1 ≤ u) (huv : u ≤ v) :
    (∑ n ∈ Finset.Icc (Nat.ceil (u * x)) (Nat.floor (v * x)),
