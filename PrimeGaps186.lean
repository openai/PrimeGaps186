    have hlarge : x ^ (θ + ε) ≤ scale ν 1 := by
      have hmul := mul_le_mul_of_nonneg_right hshort.le hNpos.le
      have hp : x ^ (b₀ + τ) * x ^ (a₀ - τ) = x := by
        rw [← Real.rpow_add hxpos,
