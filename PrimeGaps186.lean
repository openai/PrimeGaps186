theorem minorant_halfspaces1_eq_convexHull :
    {z : Fin 4 → ℝ | (∀ j, -2 ≤ z j) ∧ -2 ≤ -(∑ j, z j) ∧
      z 1 ≤ z 0 ∧ z 2 ≤ z 1 ∧ z 3 ≤ z 2 ∧
      z 3 ≤ -(∑ j, z j) ∧ z 0 + z 1 ≤ 1 ∧
      -1 ≤ z 1 + z 2 + z 3} = convexHull ℝ (Set.range minorantVertices1) := by
  apply Set.Subset.antisymm
  · rw [minorant_halfspaces1_eq_iUnion]
    apply Set.iUnion_subset
    intro j
    exact convexHull_mono (Set.range_comp_subset_range _ _)
  · exact convexHull_min (Set.range_subset_iff.mpr minorantVertices1_mem_halfspaces)
      convex_minorant_halfspaces1

