  have hq1Pos : 0 < (q1 : ℝ) := by positivity
  have hq1qReal : (q1 : ℝ) ≤ q := by exact_mod_cast hq1q
  have hlogq1Nonneg : 0 ≤ Real.log (q1 : ℝ) :=
    (Real.log_pos (by exact_mod_cast hq1)).le
