      fun h hh => Finset.mem_Icc.mpr (hJnat h hh).2
    have hcard : ((Finset.Icc (-(HN : ℤ)) (HN : ℤ)).card : ℝ) = 2 * (HN : ℝ) + 1 := by
      have hh := Int.card_Icc_of_le (a := -(HN : ℤ)) (b := (HN : ℤ)) (by omega)
      have hh' : ((Finset.Icc (-(HN : ℤ)) (HN : ℤ)).card : ℝ) =
          (HN : ℝ) + 1 - (-(HN : ℝ)) := by exact_mod_cast hh
      linarith only [hh']
    calc
      (J.card : ℝ) ≤ ((Finset.Icc (-(HN : ℤ)) (HN : ℤ)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
      _ = 2 * (HN : ℝ) + 1 := hcard
      _ ≤ 5 * H := by linarith only [hHN, hHone]
  have hFcard : (F.card : ℝ) ≤ 4 * Q ^ 2 / (q₀ : ℝ) ^ 2 := by
    let QN : ℕ := ⌊2 * Q / (q₀ : ℝ)⌋₊
    have hsub : F ⊆ (Finset.Icc 1 QN) ×ˢ (Finset.Icc 1 QN) := by
      intro t ht
      apply Finset.mem_product.mpr
      constructor
      · exact Finset.mem_Icc.mpr ⟨(hpositive t ht).1,
          (Nat.le_floor_iff (by positivity)).mpr (hcoordinate t ht).1⟩
      · exact Finset.mem_Icc.mpr ⟨(hpositive t ht).2,
          (Nat.le_floor_iff (by positivity)).mpr (hcoordinate t ht).2⟩
    have hcard : F.card ≤ QN ^ 2 := by
      simpa only [Finset.card_product, Nat.card_Icc, Nat.add_sub_cancel, pow_two] using
        Finset.card_le_card hsub
