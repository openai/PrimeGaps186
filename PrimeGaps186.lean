            (s : ℝ) * K * (τ : ℝ) :=
          Finset.sum_coe_sort (s := R) (f := fun r : ℕ =>
            ∑ _m ∈ I, ∑ s ∈ S r, (s : ℝ) * K * (τ : ℝ))
