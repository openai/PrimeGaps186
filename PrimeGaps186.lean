  have hYq (q : ℕ × ℕ) (hq : q ∈ Fq) :
      Nonempty (DenseDivisibilityWitness Y 1 (r * q₀ * q.1)) ∧
      Nonempty (DenseDivisibilityWitness Y 1 (r * q₀ * q.2)) := by
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hq
    exact hY v hv
  let P : ℕ → ℕ → ℕ := fun v w =>
    Nat.lcm (r * q₀ * q₁ * v) (r * q₀ * q₁ * w)
  have hP (v : ℕ) (hv : v ∈ F) (w : ℕ) (hw : w ∈ F) :
      0 < P v w ∧ (r : ℝ) ≤ (P v w : ℝ) ∧ (P v w : ℝ) ≤ P₀ := by
    have hvpos : 0 < v := (hF v hv).1
