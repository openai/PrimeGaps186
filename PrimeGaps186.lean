      obtain ⟨Kp, Xp, hKp, hXp, hp⟩ :=
        primeIndicator_dyadic_allModuli_bombieriVinogradov θ hθ0 hθ A hA
      obtain ⟨Kd, Xd, hKd, hXd, hd⟩ :=
        exceptionalPrimeDefect_ordinary_bv_log_saving θ hθ0 hθ A hA
