      x ^ (4 * ((9519 : ℝ) / 50000)) ≤ P ∧ P ≤ x ^ ((24 : ℝ) / 25) ∧
      (1 : ℝ) / 25 ≤ beta ∧ beta ≤ 1 - 4 * ((9519 : ℝ) / 50000) ∧
      Real.logb x P = ∑ i, t i ∧
