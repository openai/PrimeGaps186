        (pow_le_pow_left₀ (Nat.cast_nonneg _) hcard 2)
    _ = (n.divisors.card : ℝ) ^ 3 := by
      simp only [Finset.sum_const, nsmul_eq_mul,
        ← Nat.map_div_right_divisors, Finset.card_map]
      ring

theorem norm_four_divisor_sum_le_divisor_cube (n : ℕ)
    (w : ℕ → ℕ → ℕ → ℕ → ℂ)
    (hw : ∀ a ∈ n.divisorsAntidiagonal, ∀ b ∈ a.2.divisorsAntidiagonal,
      ∀ c ∈ b.2.divisorsAntidiagonal, ‖w a.1 b.1 c.1 c.2‖ ≤ 1) :
