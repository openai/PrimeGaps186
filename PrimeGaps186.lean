  · have hlogprod : Real.logb x ((∏ i ∈ S, p i : ℕ) : ℝ) = ∑ i ∈ S, α i := by
      rw [Nat.cast_prod]
      exact Real.logb_prod S _ (fun i _ => (hp0 i).ne')
    apply (Real.le_logb_iff_rpow_le hx1 hSpos).mp
    rw [hlogprod]
    exact hSlo
  · have hlogprod : Real.logb x ((∏ i ∈ S, p i : ℕ) : ℝ) = ∑ i ∈ S, α i := by
      rw [Nat.cast_prod]
      exact Real.logb_prod S _ (fun i _ => (hp0 i).ne')
    apply (Real.logb_le_iff_le_rpow hx1 hSpos).mp
