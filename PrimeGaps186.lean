    _ ≤ ∑ q ∈ S, (q.divisors.card : ℝ) ^ J * (4 * (h : ℝ)) := by
      apply Finset.sum_le_sum
      intro q hq
      exact mul_le_mul_of_nonneg_left
        (primeIndicator_shifted_discrepancy_sub_le L R h q (a q) (Finset.mem_Icc.mp (hS hq)).1)
