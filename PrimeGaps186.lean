        Nonempty (DenseDivisibilityWitness Y 1 (p.1 * p.2)) ∧
        (∀ t ∈ p.1.primeFactors, Brough < t) := by
    obtain ⟨hpE, hq, hr, _hcop, hlo, hhi, hrough, hdq, hdfull⟩ := hSraw p hp
    have hpSource : p.1 * p.2 ∈ S₀ := (Finset.mem_filter.mp hpE).1
    have hdiv := (hS₀data _ hpSource).2.2
    exact ⟨hq, hr, hproductSquarefree.squarefree_of_dvd hdiv, hpE, hdiv,
