  obtain ⟨Z, hZ⟩ := hcenter η (by
    intro q _
    rw [hηq]
    exact (hζ q).1.le)
  let S : ℕ → ℂ := fun b =>
    ∑ q ∈ Qset, η (q : ℕ) * R q (b : ZMod (q : ℕ))
  have hmean : (∑ b ∈ P, S b) / (G.totient : ℂ) =
