        N {p : ℝ | (R.activation : ℝ) < p ∧
          (if R.order ≤ 2 then ¬ (μ.real (Set.Ici p) + p < (R.outerThreshold : ℝ))
          else ¬ (μ.real (Set.Ici p) + min ((3 / 2) * p) L < (R.outerThreshold : ℝ) ∧
