  let : NeZero u₁ := ⟨hpos.2.2.1.ne'⟩
  let : NeZero v₁ := ⟨hpos.2.2.2.1.ne'⟩
  let : NeZero v₂ := ⟨hpos.2.2.2.2.1.ne'⟩
  let : NeZero q₂ := ⟨hpos.2.2.2.2.2.ne'⟩
  let : NeZero d := ⟨hdpos.ne'⟩
