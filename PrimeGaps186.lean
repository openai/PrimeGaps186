open Classical in
theorem sourceDispersionFrequencyBlock_diagonal_norm_le
    (J : Finset ℤ) (s : Finset ℤ) (H : ℕ)
    (hJ : J ⊆ (Finset.Icc (-(H : ℤ)) (H : ℤ)).filter (fun h => h ≠ 0))
    (ψM wN : ℝ → ℝ) (c T M L : ℝ)
    (hc : 0 < c) (hcT : c ≤ T) (hM : 0 < M) (hL : 0 ≤ L)
    (hsM : Function.support ψM ⊆ Set.Icc c T)
    (hbM : ∀ t : ℝ, |ψM t| ≤ L)
    (hsN : ∀ n : ℤ, n ∉ s → wN (n : ℝ) = 0)
    (r q₀ u v₁ v₂ q₂ a b₁ b₂ : ℕ) (ℓ : ℤ)
    (hv₁ : 0 < v₁) (hv₂ : 0 < v₂) :
    let g := Nat.gcd v₁ v₂
