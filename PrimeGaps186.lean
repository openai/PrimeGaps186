theorem firstOuterLow_hybrid_coeff_bounds
    (Q mark : Polynomial ℚ) (D : Polynomial ℝ) (e : Fin 2) (j : ℕ)
    (hQ : ∀ a, 0 ≤ Q.coeff a) (hmark : ∀ a, 0 ≤ mark.coeff a)
    (hD : ∀ a, 0 ≤ D.coeff a) :
    let q : ℕ → Polynomial ℚ :=
      fun r => Polynomial.C ((r.factorial : ℚ)⁻¹) * Q ^ r
