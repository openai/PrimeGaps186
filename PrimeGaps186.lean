    Finset.forall_mem_insert, Finset.mem_singleton, forall_eq] at htests
  obtain ⟨⟨hlo, hhi, hxi, h10⟩, h0a, h01, h1z, h12⟩ := htests
  simp only [MinorantSmallMonomialCut.value, Bool.false_eq_true, ite_true, ite_false,
