        ⟨R ^ ((physicalSourceRow ν t.val).activation : ℝ), hξ⟩
        (physicalSourceRow ν t.val).order (Nat.lcm (∏ j, d j) (∏ j, e j))) := by
  classical
  intro q T y z₀ z hf hg hd he hband
  obtain ⟨r, hr, hfr, hdr⟩ :=
    selberg_sampled_coefficient_root T f Z₀ (i.insertNth 1 d) hd
  obtain ⟨_, _, _, s, hs, hgs, hes⟩ :=
    selberg_sampled_erased_coefficient_presieve W R κ Z₁ g i e he
  have hsfull : Squarefree (∏ j : Fin 40, s j) := (Finset.mem_filter.mp hs).2
  have hsdiv : (∏ j : Fin 39, s (i.succAbove j)) ∣ ∏ j : Fin 40, s j := by
