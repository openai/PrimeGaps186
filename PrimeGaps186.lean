  apply Set.Subset.antisymm
  · intro z hz
    simp only [Set.mem_iUnion]
    rcases hz with ⟨_, _, h10, h21, h32, h3, h01, h123⟩
    have hL : 0 ≤ -z 0 - z 1 - z 2 - 2 * z 3 := by
      have h := h3
      simp [Fin.sum_univ_succ] at h
      linarith
    have hR : 0 ≤ 1 - z 0 - z 1 := by linarith
    have hT : 0 ≤ 1 + z 1 + z 2 + z 3 := by linarith
    by_cases hA : 0 ≤ 1 + z 2 + 2 * z 3
    · refine ⟨0, ?_⟩
      apply mem_convexHull_of_exists_fintype
        (![3 * (-z 0 - z 1 - z 2 - 2 * z 3) / 5,
          1 + z 2 + 2 * z 3, 6 * (z 1 - z 2) / 5,
          4 * (z 2 - z 3) / 5, 3 * (z 0 - z 1) / 5] : Fin 5 → ℝ)
        (fun k => minorantVertices1 (minorantSimplexIndices1 0 k))
      · intro k
        fin_cases k <;> norm_num <;> linarith
      · norm_num [Fin.sum_univ_succ]
        ring
      · intro k
        exact Set.mem_range_self k
      · ext r
        fin_cases r
        all_goals
