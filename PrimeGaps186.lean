theorem heathBrown_geometric_profiles_uniform :
    ∃ C : ℕ → ℝ, (∀ r : ℕ, 0 < C r) ∧
      ∀ Θ : ℝ, 1 < Θ → Θ ≤ 2 →
        let η : ℝ → ℝ := fun u =>
          if 0 < u then
            Real.smoothTransition (Real.log u / Real.log Θ + 1) -
              Real.smoothTransition (Real.log u / Real.log Θ)
          else 0
        ContDiff ℝ ∞ η ∧
          Function.support η = Set.Ioo Θ⁻¹ Θ ∧
          (∀ u : ℝ, 0 ≤ η u ∧ η u ≤ 1) ∧
          (∀ (N t : ℝ) (logWeight : Bool), 1 ≤ N → 0 ≤ t → t ≤ 10 →
            let φ : ℝ → ℝ := fun u =>
              η u * Real.rpow (N * u) (-t) *
