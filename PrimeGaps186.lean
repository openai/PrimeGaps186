      (if k = 0 then (physicalSourceOuterRadius : ℝ)
        else if k = 1 then (physicalSourceInnerRadius 0 : ℝ)
        else (physicalSourceInnerRadius 1 : ℝ)) := by
    fin_cases k
    · change ((98263 : ℝ) + 40) * (trialMesh : ℝ) ≤ (physicalSourceOuterRadius : ℝ)
      exact_mod_cast (show ((98263 : ℚ) + 40) * trialMesh ≤ physicalSourceOuterRadius
