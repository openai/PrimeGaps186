  let P : (ℕ × ℕ) → ℕ := fun q => r * q₀ * q.1 * q.2
  have hmod (q : ℕ × ℕ) (hq : q ∈ F) :
      (q₀ : ℝ) ≤ N ∧ (P q : ℝ) ≤ x ^ (10 : ℝ) ∧
        N ≤ (P q : ℝ) ^ (3 : ℝ) ∧
        (P q : ℝ) ≤ 8 * R * Q ^ 2 / (q₀ : ℝ) ∧ R * Q ≤ (P q : ℝ) := by
    rcases hF q hq with ⟨hq₁, hq₂, _, hq₁lo, hq₁hi, hq₂lo, hq₂hi⟩
    exact sourceSmoothFactor_modulus_geometry «ω» δ ε C x N R Q γ r q₀ q.1 q.2
      hω hδ hε hεsmall hC hxone hlarge hN hR hQ hNγ hNR hRQlo hRQhi hγlo hγhi
      hr hq₀ hq₁ hq₂ hRr hrR hq₁lo hq₁hi hq₂lo hq₂hi
  have hPlower (q : ℕ × ℕ) (hq : q ∈ F) :
      R * Q ^ 2 / (q₀ : ℝ) ≤ (P q : ℝ) := by
    rcases hF q hq with ⟨_, _, _, hq₁lo, _, hq₂lo, _⟩
    apply (div_le_iff₀ hqpos).mpr
    calc
