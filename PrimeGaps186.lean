open scoped ContDiff
open Classical in
theorem sourceTerminalSigma5_finite_linearization
    (s : ℕ) (hs : 0 < s) (lam lamTilde : ℤ) (hlam : lam ≠ 0)
    (D : Finset ℕ) (hD : ∀ d ∈ D, 0 < d) (I : Finset ℤ)
    (φ : ℕ → ℂ) (ψ : ℤ → ℂ) (hI : ∀ n : ℤ, ψ n ≠ 0 → n ∈ I)
    (U : ℕ → ℤ → ℤ → ℂ) :
    let kOf : ℕ × (ℤ × ℤ) → ℤ := fun p =>
      (lam * p.2.2 - lamTilde * p.2.1) / ((s : ℤ) * (p.1 : ℤ))
    let ntOf : ℤ → ℕ → ℤ → ℤ := fun k d n =>
      (lamTilde * n + (s : ℤ) * k * (d : ℤ)) / lam
    let T : Finset (ℕ × (ℤ × ℤ)) := (D ×ˢ (I ×ˢ I)).filter fun p =>
      Int.ModEq ((s * p.1 : ℕ) : ℤ) (lam * p.2.2) (lamTilde * p.2.1) ∧
        U p.1 p.2.1 p.2.2 * φ p.1 * ψ p.2.1 * ψ p.2.2 ≠ 0
    let K : Finset ℤ := T.image kOf
    K.card ≤ D.card * I.card ^ 2 ∧
      (∀ k ∈ K, ∃ d ∈ D, ∃ n ∈ I, ∃ nt ∈ I,
        lam * nt - lamTilde * n = (s : ℤ) * k * (d : ℤ) ∧
          lam ∣ lamTilde * n + (s : ℤ) * k * (d : ℤ) ∧
          ntOf k d n = nt ∧ U d n nt * φ d * ψ n * ψ nt ≠ 0) ∧
      (∀ (k : ℤ) (d : ℕ) (n : ℤ), ntOf k d n ∉ I →
        U d n (ntOf k d n) * φ d * ψ n * ψ (ntOf k d n) = 0) ∧
      (∑ d ∈ D, ∑ n ∈ I, ∑ nt ∈ I,
        if Int.ModEq ((s * d : ℕ) : ℤ) (lam * nt) (lamTilde * n) then
          U d n nt * φ d * ψ n * ψ nt else 0) =
        ∑ k ∈ K, ∑ d ∈ D, ∑ n ∈ I,
