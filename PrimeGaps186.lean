theorem sourceT5CentralTuples_monomial_truth_invariant
    (x : ℝ) (hx : 1 < x) (p q : Fin 5 → ℕ)
    (hp : ∀ i, p i ∈ (Finset.Icc (Nat.ceil (x ^ ((9519 : ℝ) / 50000)))
