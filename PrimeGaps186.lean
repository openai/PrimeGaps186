    obtain ⟨ht₁, ht₂⟩ := hpositive t ht
    obtain ⟨hs₁, hs₂⟩ := hpositive s hs
    have hp : 0 < P t s := Nat.pos_of_ne_zero
      (Nat.lcm_ne_zero (hF t ht).1.ne_zero (hF s hs).1.ne_zero)
    have hdr : r ∣ P t s :=
      (show r ∣ r * q₀ * t.1 * t.2 from ⟨q₀ * t.1 * t.2, by ring⟩).trans
