      simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using
        Finset.prod_dvd_prod_of_dvd (s := Finset.univ) d (fun _ : Fin 39 => q) (fun j _ => hdq j)
    have hdprod : (∏ j, d j) ∣ q :=
      hds.isRadical 39 q hdpow
