    · change ((89524 : ℝ) + 39) * (trialMesh : ℝ) ≤ (physicalSourceInnerRadius 0 : ℝ)
      exact_mod_cast (show ((89524 : ℚ) + 39) * trialMesh ≤ physicalSourceInnerRadius 0
        from by decide +kernel)
    · change ((89914 : ℝ) + 39) * (trialMesh : ℝ) ≤ (physicalSourceInnerRadius 1 : ℝ)
      exact_mod_cast (show ((89914 : ℚ) + 39) * trialMesh ≤ physicalSourceInnerRadius 1
        from by decide +kernel)
  let r : ℕ := ∑ i : Fin d, trialCellIndex (X i)
  let top : ℕ := if k = 0 then 98263 else if k = 1 then 89524 else 89914
  have hsize : (∑ i : Fin d, ((X i).mass : ℝ)) ≤
      ((r : ℝ) + d) * (trialMesh : ℝ) := by
    calc
