  have hφ : (0 : ℝ) < Nat.totient W := Nat.cast_pos.mpr (Nat.totient_pos.mpr hW)
  have hratio0 : 0 < (Nat.totient W : ℝ) / (W : ℝ) := div_pos hφ hWR
  have hratio1 : (Nat.totient W : ℝ) / (W : ℝ) ≤ 1 :=
    (div_le_one hWR).mpr (Nat.cast_le.mpr (Nat.totient_le W))
