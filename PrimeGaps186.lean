  have hx0 : 0 < x := (Real.exp_pos 1).trans_le hx
  have hlog1 : 1 ≤ Real.log x := (Real.le_log_iff_exp_le hx0).mpr hx
  have hlog : 0 < Real.log x := zero_lt_one.trans_le hlog1
