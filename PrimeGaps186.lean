        (closedBall ((2 : ℂ) + t * I) 3)).support.ncard : ℝ) ≤
        ((∑ᶠ z : ℂ,
          MeromorphicOn.divisor (inducingEulerProduct chi) K z : ℤ) : ℝ) := by
