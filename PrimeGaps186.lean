  have harg : T + 2 ≤ x ^ 2 := by
    have hxpoly : x + 2 ≤ x ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hx)
        (by linarith : 0 ≤ x + 1)]
    nlinarith
