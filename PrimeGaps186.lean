  let G : ℝ := (9 : ℝ) ^ q.primeFactors.card * Real.sqrt (q : ℝ) *
    (Real.sqrt (Int.gcd ((u₁ : ℤ) ^ 3 * m₁ - (u₂ : ℤ) ^ 3 * m₂)
