          (Real.sqrt (Int.gcd (a₂ * (u₁ : ℤ) ^ 3 - a₁ * (u₂ : ℤ) ^ 3)
            (d : ℤ) : ℝ) *
          Real.sqrt (Int.gcd (a₂ * (r₁ : ℤ) ^ 3 - a₁ * (r₂ : ℤ) ^ 3)
            (s : ℤ) : ℝ)) :=
        normalizedKloosterman3Mod_mixed_unit_fourier_norm_le_of_deligne
