  have hfixed := norm_logDeriv_sub_divisor_finsum_le
    (f := riemannZeta₁) (c := c) (s := s) (R := (3 : ℝ)) (M := M)
    (by norm_num) hM hf hc hbound (by simpa [c] using hs) hfs
