    have hinterval : Finset.Ico L (L + N) = Finset.Icc L U := by
      ext n
      simp only [Finset.mem_Ico, Finset.mem_Icc, hLN]
      omega
    have hprefix (k : ℕ) (hk : k ≤ N) :
        (∑ q ∈ Q, (q.divisors.card : ℝ) ^ J *
