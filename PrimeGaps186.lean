  have hAB : u * x / (p : ℝ) ≤ v * x / (p : ℝ) :=
    div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right huv hx0.le) hp0.le
  simp_rw [roughWeight_cardFactors_two_eq_sorted_pairs]
