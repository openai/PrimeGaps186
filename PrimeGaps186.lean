        z 3 ≤ -(∑ j, z j) ∧ z 0 + z 1 ≤ 1 ∧
        -1 ≤ z 1 + z 2 + z 3}).exposedPoints ℝ := by
  let a : Fin 7 → (Fin 4 → ℝ) :=
    ![![-1, -1, -1, 0], ![0, 1, 1, 3], ![0, 1, -2, 0],
      ![1, 3, 0, 3], ![0, 0, 0, -1], ![1, 2, 2, 2], ![1, 0, 0, 1]]
  refine exposed_point_def.mpr ⟨minorantVertices1_mem_halfspaces i,
    (dotProductBilin ℝ ℝ (a i)).toContinuousLinearMap, ?_⟩
  intro y hy
  rcases hy with ⟨_, _, hy10, hy21, hy32, hy3, hy01, hy123⟩
  simp only [Fin.sum_univ_four] at hy3
  change dotProduct (a i) y ≤ dotProduct (a i) (minorantVertices1 i) ∧
    (dotProduct (a i) (minorantVertices1 i) ≤ dotProduct (a i) y →
      y = minorantVertices1 i)
  fin_cases i
  all_goals
    norm_num [a, minorantVertices1, dotProduct, Fin.sum_univ_four, Fin.reduceFinMk,
      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.vecHead, Matrix.vecTail]
    constructor
    · linarith
    · intro h
      funext k
      fin_cases k <;>
        norm_num [Fin.reduceFinMk, Matrix.cons_val_two, Matrix.cons_val_three,
          Matrix.vecHead, Matrix.vecTail] <;> linarith!

