    rw [hzero, mul_zero] at hfactor
    exact hzeta hfactor
  rw [logDeriv_apply, logDeriv_apply,
    deriv_riemannZeta_eq_neg_inv_sub_sq_mul_add hs1,
    riemannZeta_eq_inv_sub_mul hs1]
  field_simp [hsub, hzeta1]
