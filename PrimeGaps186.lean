theorem largest_prime_windows_all_moduli_siegelWalfisz
    (C₀ D₀ ε c T C B H A : ℝ)
    (hε : 0 < ε) (hc : 0 < c) (hT : 0 < T) (hH : 0 ≤ H) (hA : 0 < A) :
