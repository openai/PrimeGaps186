      (envelope_coeff_map_rat_nonneg _ (hper r)) j
  · exact envelope_coeff_mul_nonneg D ((mark ^ e.val * T).map (Rat.castHom ℝ))
      hD (envelope_coeff_map_rat_nonneg _ htarget) j
  · have hmarked : ∀ a,
        (mark ^ e.val * (∑ r ∈ Finset.range 43,
          q r * eulerianCarryPolynomial (r + e.val + 1))).coeff a ≤
