    (α : ℕ → ℂ) (η : ℕ → ℕ → ℂ)
    (Wα Wη : ℝ) (hWα : 0 ≤ Wα) (hWη : 0 ≤ Wη)
    (hα : ∀ m ∈ I, ‖α m‖ ≤ Wα)
    (hη : ∀ r ∈ R, ∀ s ∈ S r, ‖η r s‖ ≤ Wη)
    (T Lw H : ℝ) (hT : 0 ≤ T) (hLw : 0 ≤ Lw) (hH : 0 < H)
    (ψ : ℝ → ℂ) (hsupport : Function.support ψ ⊆ Set.Icc (-T) T)
    (hbound : ∀ t : ℝ, ‖ψ t‖ ≤ Lw) :
    let L := Finset.Icc (Int.ceil (-T * H)) (Int.floor (T * H))
    let τ := (R ×ˢ I).sup (fun rm : ℕ × ℕ => (rm.1 ^ 3 * rm.2).divisors.card)
    let Ω := R.sup (fun r => (S r).sup (fun s => (r * s).primeFactors.card))
