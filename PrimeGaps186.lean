      (∀ i, (9519 / 50000 : ℝ) ≤ α i) ∧
        ∃ S : Finset (Fin 4), S.Nonempty ∧ S ≠ Finset.univ ∧
          (40481 / 100000 : ℝ) ≤ ∑ i ∈ S, α i ∧
