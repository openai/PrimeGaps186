      0 ≤ (1 - (p : ℝ) ^ (-(1 - 1 / Real.log Y)))⁻¹ ∧
        (1 - (p : ℝ) ^ (-(1 - 1 / Real.log Y)))⁻¹ ≤
          1 + C * (p : ℝ)⁻¹ := by
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast Nat.two_le_of_mem_primesLE hp
    have hp0 : (0 : ℝ) < p := lt_of_lt_of_le (by norm_num) hp2
    have hpY : (p : ℝ) ≤ Y :=
      (Nat.cast_le.mpr (Nat.le_of_mem_primesLE hp)).trans (Nat.floor_le hY.le)
    let u : ℝ := (p : ℝ) ^ (-(1 - 1 / Real.log Y))
    have hu0 : 0 ≤ u := Real.rpow_nonneg hp0.le _
    have huQ : u ≤ Q :=
      (Real.rpow_le_rpow_of_exponent_le (by linarith : (1 : ℝ) ≤ p)
        (by linarith : -(1 - 1 / Real.log Y) ≤ -(1 / 2 : ℝ))).trans
        (Real.rpow_le_rpow_of_nonpos (by norm_num) hp2 (by norm_num))
    have hdu : 0 < 1 - u := sub_pos.mpr (huQ.trans_lt hQ)
    have hue : u ≤ Real.exp 1 * (p : ℝ)⁻¹ := by
      have he : Real.exp (Real.log (p : ℝ) * (1 / Real.log Y)) ≤ Real.exp 1 := by
        apply Real.exp_le_exp.mpr
