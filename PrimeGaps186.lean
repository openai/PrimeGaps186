            (r₂.val : ℤ) ^ 3 * (m₂ : ℤ) = 0 then c else 0 :=
        Finset.sum_le_sum (fun r₂ _ => Finset.sum_le_sum (fun m₂ hm₂ => hf r₂ m₂ hm₂))
      _ = (D.card : ℝ) * c := by
