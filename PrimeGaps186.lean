    mul_ne_one_of_sq_eq_one_of_ne hsquare1 hne
  let L : ℝ := Real.log ((q : ℝ) * 2)
  let a : ℝ := 1 / (m * L)
  let sigma : ℝ := 1 + a
  have hscale : (2 : ℝ) ≤ (q : ℝ) * 2 := by
