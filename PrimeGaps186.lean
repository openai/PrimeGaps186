open Classical in
theorem norm_fullDiscrepancy_sample_le_two_sum_norm
    (S : Finset ℕ) (f : ℕ → ℂ) (q a : ℕ) (hq : 0 < q) :
    ‖fullDiscrepancy (∑ n ∈ S, Finsupp.single n (f n)) q a‖ ≤
