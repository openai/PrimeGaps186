      (2 * A + (P : ℝ)) (by positivity)
  refine ⟨Ks + Kg * Lamp, Xs, by positivity, hXs, ?_⟩
  intro x hx u v hxu huv hvx I hI a ha
  let Λuv : ℕ →₀ ℂ :=
    ∑ n ∈ Finset.Icc ⌈u⌉₊ ⌊v⌋₊,
      Finsupp.single n ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)
  let Q : Finset ℕ := (Finset.Icc 1 ⌊x ^ θ₀⌋₊).filter (fun q =>
    q ∣ ∏ p ∈ I, p ∧
    Nonempty (DenseDivisibilityWitness
      ⟨max 1 (x ^ δ₀), le_max_left (1 : ℝ) (x ^ δ₀)⟩ j q))
  change (∑ q ∈ Q, (q.divisors.card : ℝ) ^ J * ‖fullDiscrepancy Λuv q a‖) ≤ _
  have hxexp : Real.exp 1 ≤ x := hXs.trans hx
  have hxpos : 0 < x := (Real.exp_pos 1).trans_le hxexp
  have hlogone : 1 ≤ Real.log x := (Real.le_log_iff_exp_le hxpos).mpr hxexp
  have hlog : 0 < Real.log x := zero_lt_one.trans_le hlogone
  have hvpos : 0 < v := hxpos.trans_le (hxu.trans huv)
  have hvalue (n : ℕ) :
      Λuv n = if n ∈ Finset.Icc ⌈u⌉₊ ⌊v⌋₊ then
