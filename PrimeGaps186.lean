    change ‖∑ z ∈ m.divisorsAntidiagonal, H c e z.1 * H d f z.2‖ ≤ _
    calc
      _ ≤ ∑ z ∈ m.divisorsAntidiagonal, ‖H c e z.1 * H d f z.2‖ :=
        norm_sum_le _ _
      _ ≤ ∑ _z ∈ m.divisorsAntidiagonal,
          1024 * (m.divisors.card : ℝ) ^ 18 * (Real.log (m : ℝ)) ^ 2 := by
        apply Finset.sum_le_sum
