        (s : {s : ℕ // s ∈ S r₁.val}) (m₁ m₂ : ℕ) : ℂ :=
      letI : NeZero (r₁.val * s.val) :=
        ⟨mul_ne_zero (hR r₁.val r₁.property).ne_zero
          (hS r₁.val r₁.property s.val s.property).ne_zero⟩
      letI : NeZero (r₂.val * s.val) :=
        ⟨mul_ne_zero (hR r₂.val r₂.property).ne_zero
