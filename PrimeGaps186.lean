theorem literal_minorant_buchstab_discrepancy :
    ∀ᶠ x : ℝ in atTop, ∀ S : Finset ℕ,
      S ⊆ Finset.Icc ⌈x⌉₊ ⌊2 * x⌋₊ → ∀ q a : ℕ,
