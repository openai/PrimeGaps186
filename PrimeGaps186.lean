      exact hpnot (Fintype.mem_piFinset.mpr
        (prime_five_mem_compact_band x hx hgap p hpprime hl hupper))

open Classical in
theorem prime_prefix_interval_log_geometry
    (x u v : ℝ) (hx : 1 < x) (hu : 1 ≤ u) (hv : v ≤ 2)
