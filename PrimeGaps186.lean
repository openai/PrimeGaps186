  have hA₂ := isUnit_intCast_of_dvd (r₂ * s) q hq₂ A hA
  obtain ⟨a₁, ha₁⟩ := ZMod.intCast_surjective
    ((A : ZMod (r₁ * s)) * (m₁ : ZMod (r₁ * s))⁻¹)
  obtain ⟨a₂, ha₂⟩ := ZMod.intCast_surjective
